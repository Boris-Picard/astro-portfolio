---
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import {
  Calendar,
  MapPin,
  GraduationCap,
  Briefcase,
  Award,
  Code2,
  Download,
  ArrowRight,
  BookOpen,
} from "lucide-react";
---

<section id="about" class="py-32 relative overflow-hidden">
  <!-- Enhanced gradient background -->
  <div
    class="absolute inset-0 bg-gradient-to-br from-purple-500/3 via-transparent to-orange-500/5"
  >
  </div>
  <div
    class="absolute top-1/3 right-1/4 w-64 h-64 rounded-full bg-gradient-to-br from-orange-500/10 to-purple-500/5 blur-3xl"
  >
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-20 reveal">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">About Me</h2>
        <div
          class="w-20 h-1 bg-gradient-to-r from-orange-500 to-orange-600 rounded-full mx-auto mb-8"
        >
        </div>
        <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
          Passionate about creating exceptional mobile experiences that users
          love
        </p>
      </div>

      <!-- Main Content Grid -->
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12">
        <!-- Left Column - Profile & Stats -->
        <div class="lg:col-span-4 space-y-8">
          <!-- Profile Card -->
          <div class="reveal">
            <div class="experience-card rounded-3xl p-8 text-center">
              <!-- Profile Image -->
              <div class="relative mx-auto mb-6 w-32 h-32">
                <div
                  class="w-full h-full rounded-full bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center text-white text-4xl font-bold"
                >
                  AC
                </div>
                <div
                  class="absolute -bottom-2 -right-2 w-8 h-8 bg-green-500 rounded-full border-4 border-background flex items-center justify-center"
                >
                  <div class="w-2 h-2 bg-white rounded-full"></div>
                </div>
              </div>

              <h3 class="text-xl font-bold experience-title mb-2">Alex Chen</h3>
              <p class="text-orange-500 font-medium mb-4">
                Senior Mobile Developer
              </p>
              <p class="text-muted-foreground text-sm mb-6">
                San Francisco, CA • Open to new opportunities
              </p>

              <Button
                class="w-full bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white border-none group"
              >
                <Download class="w-4 h-4 mr-2" />
                <span>Download CV</span>
              </Button>
            </div>
          </div>

          <!-- Stats Grid -->
          <div class="grid grid-cols-2 gap-4 reveal reveal-delay-1">
            <div class="experience-card rounded-2xl p-6 text-center">
              <div class="text-3xl font-bold text-orange-500 mb-2">5+</div>
              <div class="text-sm text-muted-foreground">Years Experience</div>
            </div>
            <div class="experience-card rounded-2xl p-6 text-center">
              <div class="text-3xl font-bold text-orange-500 mb-2">50+</div>
              <div class="text-sm text-muted-foreground">
                Projects Completed
              </div>
            </div>
            <div class="experience-card rounded-2xl p-6 text-center">
              <div class="text-3xl font-bold text-orange-500 mb-2">100K+</div>
              <div class="text-sm text-muted-foreground">App Downloads</div>
            </div>
            <div class="experience-card rounded-2xl p-6 text-center">
              <div class="text-3xl font-bold text-orange-500 mb-2">15+</div>
              <div class="text-sm text-muted-foreground">Happy Clients</div>
            </div>
          </div>
        </div>

        <!-- Right Column - Content -->
        <div class="lg:col-span-8 space-y-8">
          <!-- Bio -->
          <div class="reveal reveal-delay-2">
            <div class="experience-card rounded-3xl p-8">
              <h3 class="text-2xl font-bold experience-title mb-6">My Story</h3>
              <div class="space-y-4 text-muted-foreground leading-relaxed">
                <p>
                  With over <span class="text-orange-500 font-medium"
                    >5 years of experience</span
                  > in mobile development, I've had the privilege of working with
                  startups and established companies to bring their mobile visions
                  to life.
                </p>
                <p>
                  My journey began with a passion for creating seamless user
                  experiences. I specialize in
                  <span class="text-orange-500 font-medium">React Native</span> and
                  <span class="text-orange-500 font-medium">Flutter</span>, but
                  I'm equally comfortable with native iOS and Android
                  development.
                </p>
                <p>
                  I believe that great mobile apps are born from the perfect
                  blend of beautiful design, clean code, and deep understanding
                  of user behavior. Every project I work on is an opportunity to
                  push the boundaries of what's possible on mobile platforms.
                </p>
              </div>
            </div>
          </div>

          <!-- Education & Formations -->
          <div class="reveal reveal-delay-3">
            <div class="experience-card rounded-3xl p-8">
              <h3
                class="text-2xl font-bold experience-title mb-6 flex items-center gap-3"
              >
                <BookOpen class="w-6 h-6 text-orange-500" />
                My Formations
              </h3>
              <div class="space-y-6">
                <!-- University Education -->
                <div class="flex gap-4">
                  <div
                    class="flex-shrink-0 w-12 h-12 rounded-full bg-orange-500/10 flex items-center justify-center"
                  >
                    <GraduationCap class="w-5 h-5 text-orange-500" />
                  </div>
                  <div class="flex-1">
                    <div
                      class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-2"
                    >
                      <h4 class="font-semibold experience-title">
                        Computer Science, B.S.
                      </h4>
                      <span class="text-sm text-orange-500 font-medium"
                        >2016 - 2020</span
                      >
                    </div>
                    <p class="text-orange-500 text-sm mb-2">
                      Stanford University
                    </p>
                    <p class="text-muted-foreground text-sm">
                      Magna Cum Laude • Focus on Mobile Computing,
                      Human-Computer Interaction, and Software Engineering
                    </p>
                  </div>
                </div>

                <!-- Professional Certifications -->
                <div class="flex gap-4">
                  <div
                    class="flex-shrink-0 w-12 h-12 rounded-full bg-blue-500/10 flex items-center justify-center"
                  >
                    <Award class="w-5 h-5 text-blue-500" />
                  </div>
                  <div class="flex-1">
                    <h4 class="font-semibold experience-title mb-3">
                      Professional Certifications
                    </h4>
                    <div class="grid md:grid-cols-2 gap-3">
                      <div class="bg-muted-custom rounded-lg p-3">
                        <p class="text-sm font-medium experience-title">
                          Google Associate Android Developer
                        </p>
                        <p class="text-xs text-muted-foreground">2023</p>
                      </div>
                      <div class="bg-muted-custom rounded-lg p-3">
                        <p class="text-sm font-medium experience-title">
                          AWS Certified Solutions Architect
                        </p>
                        <p class="text-xs text-muted-foreground">2022</p>
                      </div>
                      <div class="bg-muted-custom rounded-lg p-3">
                        <p class="text-sm font-medium experience-title">
                          Meta React Native Specialist
                        </p>
                        <p class="text-xs text-muted-foreground">2023</p>
                      </div>
                      <div class="bg-muted-custom rounded-lg p-3">
                        <p class="text-sm font-medium experience-title">
                          Apple iOS Development
                        </p>
                        <p class="text-xs text-muted-foreground">2021</p>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Continuous Learning -->
                <div class="flex gap-4">
                  <div
                    class="flex-shrink-0 w-12 h-12 rounded-full bg-green-500/10 flex items-center justify-center"
                  >
                    <Code2 class="w-5 h-5 text-green-500" />
                  </div>
                  <div class="flex-1">
                    <h4 class="font-semibold experience-title mb-3">
                      Continuous Learning
                    </h4>
                    <div class="flex flex-wrap gap-2">
                      <Badge
                        class="bg-green-500/10 text-green-500 border border-green-500/20"
                        >Advanced React Patterns</Badge
                      >
                      <Badge
                        class="bg-green-500/10 text-green-500 border border-green-500/20"
                        >Mobile UI/UX Design</Badge
                      >
                      <Badge
                        class="bg-green-500/10 text-green-500 border border-green-500/20"
                        >Cloud Architecture</Badge
                      >
                      <Badge
                        class="bg-green-500/10 text-green-500 border border-green-500/20"
                        >DevOps for Mobile</Badge
                      >
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Experience Timeline -->
          <div class="reveal reveal-delay-4">
            <div class="experience-card rounded-3xl p-8">
              <h3
                class="text-2xl font-bold experience-title mb-6 flex items-center gap-3"
              >
                <Briefcase class="w-6 h-6 text-orange-500" />
                Professional Experience
              </h3>
              <div class="space-y-6">
                <div class="flex gap-4">
                  <div
                    class="flex-shrink-0 w-12 h-12 rounded-full bg-orange-500/10 flex items-center justify-center"
                  >
                    <div class="w-3 h-3 rounded-full bg-orange-500"></div>
                  </div>
                  <div class="flex-1">
                    <div
                      class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-2"
                    >
                      <h4 class="font-semibold experience-title">
                        Senior Mobile Developer
                      </h4>
                      <span class="text-sm text-orange-500 font-medium"
                        >2022 - Present</span
                      >
                    </div>
                    <p class="text-orange-500 text-sm mb-2">TechCorp Inc.</p>
                    <p class="text-muted-foreground text-sm">
                      Leading a team of 5 developers, architecting scalable
                      mobile solutions, and mentoring junior developers in best
                      practices.
                    </p>
                  </div>
                </div>

                <div class="flex gap-4">
                  <div
                    class="flex-shrink-0 w-12 h-12 rounded-full bg-orange-500/10 flex items-center justify-center"
                  >
                    <div class="w-3 h-3 rounded-full bg-orange-500/50"></div>
                  </div>
                  <div class="flex-1">
                    <div
                      class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-2"
                    >
                      <h4 class="font-semibold experience-title">
                        Mobile Developer
                      </h4>
                      <span class="text-sm text-orange-500 font-medium"
                        >2020 - 2022</span
                      >
                    </div>
                    <p class="text-orange-500 text-sm mb-2">StartupXYZ</p>
                    <p class="text-muted-foreground text-sm">
                      Developed cross-platform mobile applications using React
                      Native and Flutter, working closely with design and
                      product teams.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
