---
import { buttonVariants } from "@/components/ui/button";
import {
  Calendar,
  MapPin,
  GraduationCap,
  Briefcase,
  Award,
  Download,
  BookOpen,
} from "lucide-react";
import {
  profile,
  education,
  certifications,
  experiences,
} from "@/data/profile";
import { Image } from "astro:assets";
import { Badge } from "./ui/badge";
import { cn } from "@/lib/utils";
---

<section id="about" class="py-32 relative overflow-hidden">
  <!-- Background -->
  <div
    class="absolute inset-0 bg-gradient-to-br from-orange-500/6 via-transparent to-amber-500/4"
  >
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-tl from-yellow-500/3 via-transparent to-orange-500/5"
  >
  </div>
  <div
    class="absolute top-1/3 right-1/4 w-64 h-64 rounded-full bg-gradient-to-br from-orange-500/10 to-amber-500/6 blur-3xl"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <!-- Header -->
    <div class="text-center mb-20 reveal">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">À propos</h2>
      <div
        class="w-20 h-1 bg-gradient-to-r from-orange-500 to-amber-600 rounded-full mx-auto mb-8"
      >
      </div>
    <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        Je conçois des applications web robustes et modernes. Curieux et impliqué, j’avance entre projet pro et montée en compétences continue.
    </p>
    </div>

    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-1 space-y-8">
        <!-- Profile Card -->
        <div class="glass rounded-2xl p-[1px] overflow-hidden reveal">
          <div
            class="absolute -inset-[1px] bg-gradient-to-r from-transparent via-orange-400 to-transparent opacity-20 blur-sm"
          >
          </div>
          <div class="card-bg rounded-2xl p-8 relative z-10 text-center">
            <div class="relative mx-auto mb-6 w-32 h-32">
               <Image  
                src={profile.image}
                alt={profile.name}
                width={128}
                height={128}
                class="w-full h-full object-cover rounded-full"
                        /> 
              {
                profile.available && (
                  <div class="absolute -bottom-2 -right-2 flex items-center justify-center">
                    <span class="absolute inline-flex h-8 w-8 rounded-full bg-green-400 opacity-50 animate-ping" />
                    <span class="relative inline-flex h-3 w-3 rounded-full bg-green-500 shadow-lg" />
                  </div>
                )
              }
            </div>
            <h3 class="text-xl font-bold mb-2">{profile.name}</h3>
            <p class="text-orange-500 font-medium mb-2">{profile.role}</p>
            <div
              class="flex items-center justify-center gap-2 text-sm text-muted-foreground mb-6"
            >
              <MapPin className="w-4 h-4" />
              <span>{profile.location}</span>
            </div>
            {
              profile.available && (
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-green-500/10 border border-green-500/20 text-green-600 text-sm font-medium mb-6">
                  <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse" />
                  Available for new opportunities
                </div>
              )
            }
            <a
              href={profile.cv}
              download
              class={cn(
                buttonVariants({ variant: "default", size: "default" }),
                "w-50 bg-gradient-to-r from-orange-500 to-amber-600 border-none text-white group rounded-full"
              )}
            >
              <Download className="w-4 h-4 mr-2" />
              Télécharger mon CV
            </a>
          </div>
        </div>

        <!-- Education & Certifications -->
        <div
          class="glass rounded-2xl p-[1px] overflow-hidden reveal reveal-delay-1"
        >
          <div
            class="absolute -inset-[1px] bg-gradient-to-r from-transparent via-amber-400 to-transparent opacity-20 blur-sm"
          >
          </div>
          <div class="card-bg rounded-2xl p-8 relative z-10">
            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-400 to-amber-500 flex items-center justify-center shadow-lg"
              >
                <GraduationCap className="w-6 h-6 text-white" />
              </div>
              <div>
                <h3 class="text-xl font-semibold">Education</h3>
                <p class="text-sm text-muted-foreground">Academic Background</p>
              </div>
            </div>
            <div class="space-y-4">
              {
                education.map((edu) => (
                  <div class="p-4 bg-muted-custom rounded-lg border border-amber-500/10 hover:border-amber-500/20 transition-colors">
                    <div class="flex items-center justify-between mb-2">
                      <h4 class="font-semibold text-sm">{edu.degree}</h4>
                      <div
                        class={`flex items-center gap-2 text-end text-xs text-${edu.color}-500 bg-${edu.color}-500/10`}
                      >
                        {edu.period}
                      </div>
                    </div>
                    {edu.institution.map(({name, logo}) => {
                    return <div class="flex gap-2 items-center mb-2">
                    <Image
                          src={logo}
                          alt={`${name} logo`}
                          class="w-5 h-5 object-contain"
                        /> 
                      <span class="text-xs font-medium text-center">
                          {name}
                        </span>
                    </div> 
                    })}
                    {edu.honors && (
                      <p class="text-muted-foreground text-xs">{edu.honors}</p>
                    )}
                  </div>
                ))
              }

              <div>
                <div class="flex items-center gap-2 mb-3">
                  <Award className="w-4 h-4 text-orange-500" />
                  <h4 class="font-semibold text-sm">Certifications</h4>
                </div>
                <div class="space-y-2">
                  {
                    certifications.map((cert) => (
                      <div class="flex items-center justify-between p-3 bg-muted-custom rounded-lg border border-orange-500/10 hover:border-orange-500/20 transition-colors group">
                        <span class="text-xs font-medium">{cert.title}</span>
                        <span class="text-xs text-orange-500">{cert.year}</span>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-2 space-y-8">
        <!-- My Story -->
        <div
          class="glass rounded-2xl p-[1px] overflow-hidden reveal reveal-delay-2"
        >
          <div
            class="absolute -inset-[1px] bg-gradient-to-r from-transparent via-orange-400 to-transparent opacity-20 blur-sm"
          >
          </div>
          <div class="card-bg rounded-2xl p-8 relative z-10">
            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-400 to-orange-500 flex items-center justify-center shadow-lg"
              >
                <BookOpen className="w-6 h-6 text-white" />
              </div>
              <div>
                <h3 class="text-xl font-semibold">Mon Parcours</h3>
                <p class="text-sm text-muted-foreground">
                  Un chemin vers le développement professionnel
                </p>
              </div>
            </div>
          <div class="space-y-4 text-muted-foreground leading-relaxed">
            <p>
              De septembre 2023 à mars 2024, j’ai suivi une formation intensive à 
              <span class="text-orange-500 font-medium">LA MANU</span>, obtenant le titre de 
              <span class="text-orange-500 font-medium">Développeur Web et Web Mobile</span>. 
              J’y ai acquis les bases solides du développement : 
              <span class="text-orange-500 font-medium">HTML</span>, 
              <span class="text-orange-500 font-medium">CSS</span>, 
              <span class="text-orange-500 font-medium">JavaScript</span>, 
              <span class="text-orange-500 font-medium">PHP</span>, 
              <span class="text-orange-500 font-medium">MySQL</span> et la 
              <span class="text-orange-500 font-medium">programmation orientée objet</span>.
            </p>

            <p>
              En parallèle, je me suis formé en autonomie sur des technologies modernes comme 
              <span class="text-orange-500 font-medium">React</span>, 
              <span class="text-orange-500 font-medium">Next.js</span>, 
              <span class="text-orange-500 font-medium">Prisma</span>, 
              <span class="text-orange-500 font-medium">PostgreSQL</span> et 
              <span class="text-orange-500 font-medium">Symfony</span>. 
              J’ai appris à conteneuriser mes projets avec 
              <span class="text-orange-500 font-medium">Docker</span> 
              et à automatiser leur déploiement via 
              <span class="text-orange-500 font-medium">GitHub Actions</span>, 
              déployés sur des plateformes comme 
              <span class="text-orange-500 font-medium">Vercel</span>, 
              <span class="text-orange-500 font-medium">Koyeb</span> ou 
              <span class="text-orange-500 font-medium">Neon</span> selon les projets.
            </p>

            <p>
              Depuis septembre 2024, je suis en alternance chez 
              <span class="text-orange-500 font-medium">Actimage</span>, 
              où je développe des projets full stack en 
              <span class="text-orange-500 font-medium">Drupal</span>, 
              <span class="text-orange-500 font-medium">Twig</span>, 
              <span class="text-orange-500 font-medium">Symfony</span> et 
              <span class="text-orange-500 font-medium">SASS</span>. 
              En parallèle, je prépare mon diplôme de 
              <span class="text-orange-500 font-medium">Concepteur Développeur d’Applications</span> au 
              <span class="text-orange-500 font-medium">CESI</span>.
            </p>

            <p>
              Je poursuis également une montée en compétences en
              <span class="text-orange-500 font-medium">intelligence artificielle</span> avec 
              <span class="text-orange-500 font-medium">Python</span>, 
              en apprenant à manipuler les données avec 
              <span class="text-orange-500 font-medium">NumPy</span>, 
              <span class="text-orange-500 font-medium">Pandas</span> 
              et à poser les bases du 
              <span class="text-orange-500 font-medium">machine learning</span> via 
              <span class="text-orange-500 font-medium">scikit-learn</span>
              pour préparer de futurs projets mêlant IA et data science.
            </p>
          </div>
          </div>
        </div>

        <!-- Professional Experience -->
        <div
          class="glass rounded-2xl p-[1px] overflow-hidden reveal reveal-delay-3"
        >
          <div
            class="absolute -inset-[1px] bg-gradient-to-r from-transparent via-yellow-400 to-transparent opacity-20 blur-sm"
          >
          </div>
          <div class="card-bg rounded-2xl p-8 relative z-10">
            <div class="flex items-center gap-4 mb-8">
              <div
                class="w-12 h-12 rounded-xl bg-gradient-to-br from-yellow-400 to-yellow-500 flex items-center justify-center shadow-lg"
              >
                <Briefcase className="w-6 h-6 text-white" />
              </div>
              <div>
                <h3 class="text-xl font-semibold">Professional Experience</h3>
                <p class="text-sm text-muted-foreground">Career Timeline</p>
              </div>
            </div>
            <div class="space-y-6">
              {
                experiences.map((exp) => (
                  <div class="relative flex gap-6">
                    <div class="flex flex-col items-center">
                      <div
                        class={`w-4 h-4 rounded-full bg-${exp.color}-500 border-2 border-background shadow-lg`}
                      />
                      <div
                        class={`w-px h-16 bg-gradient-to-b from-${exp.color}-500 to-${exp.color}-300 mt-2`}
                      />
                    </div>
                    <div class="flex-1">
                      <div class="flex items-center justify-between mb-2">
                        <h4 class="font-semibold">{exp.title}</h4>
                        <div
                          class={`flex items-center gap-2 text-xs text-${exp.color}-500 bg-${exp.color}-500/10 px-2 py-1 rounded-full`}
                        >
                          <Calendar className="w-3 h-3" />
                          {exp.period}
                        </div>
                      </div>
                      <div
                        class={`flex items-center text-${exp.color}-500 text-sm font-medium mb-3 gap-2`}
                      >
                        {exp.company.map(({name, logo}) => {
                        return <Image
                          src={logo}
                          alt={`${name} logo`}
                          class="w-5 h-5 object-contain"
                        />
                        <span class="text-black dark:text-white">{name}</span>
                        })}
                      </div>
                      <p class="text-muted-foreground text-sm leading-relaxed mb-3">
                        {exp.description}
                      </p>
                      <div class="flex flex-wrap gap-2">
                        {exp.highlights.map((h) => (
                          <div class="flex items-center gap-1">
                            <div
                              class="w-2 h-2 rounded-full"
                              style={{ backgroundColor: h.color }}
                            />
                            <span class="text-xs text-muted-foreground">
                              {h.name}
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
