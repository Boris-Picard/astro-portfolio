---
import { Button } from "@/components/ui/button";
import {
  Mail,
  MapPin,
  Phone,
  Calendar,
  Github,
  Linkedin,
  ArrowRight,
} from "lucide-react";
---

<section id="contact" class="py-32 relative overflow-hidden">
  <!-- Enhanced gradient background -->
  <div
    class="absolute inset-0 bg-gradient-to-br from-orange-500/5 via-transparent to-purple-500/5"
  >
  </div>
  <div
    class="absolute top-1/3 left-1/4 w-96 h-96 rounded-full bg-gradient-to-br from-orange-500/10 to-pink-500/5 blur-3xl"
  >
  </div>
  <div
    class="absolute bottom-1/4 right-1/4 w-64 h-64 rounded-full bg-gradient-to-br from-blue-500/5 to-orange-500/10 blur-3xl"
  >
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-20 reveal">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Let's Work Together</h2>
        <div
          class="w-20 h-1 bg-gradient-to-r from-orange-500 to-orange-600 rounded-full mx-auto mb-8"
        >
        </div>
        <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
          Ready to bring your mobile app idea to life? Let's discuss your
          project
        </p>
      </div>

      <!-- Centered single column layout -->
      <div class="max-w-2xl mx-auto space-y-8">
        <!-- Main Contact Card -->
        <div class="glass rounded-3xl p-[1px] overflow-hidden reveal">
          <div
            class="absolute -inset-[1px] bg-gradient-to-r from-orange-500/20 via-pink-500/10 to-blue-500/20 blur-sm"
          >
          </div>
          <div class="card-bg rounded-3xl p-8 relative z-10">
            <h3 class="text-2xl font-semibold mb-6 text-center">
              Get in touch
            </h3>
            <p class="text-muted-foreground mb-8 leading-relaxed text-center">
              I'm always excited to work on new projects and collaborate with
              amazing teams. Whether you have a specific project in mind or just
              want to chat about mobile development, I'd love to hear from you.
            </p>

            <div class="grid md:grid-cols-2 gap-4 mb-8">
              <a
                href="mailto:alex@example.com"
                class="flex flex-col items-center gap-4 p-6 border border-custom rounded-xl hover-bg-custom transition-all group"
              >
                <div
                  class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center text-white"
                >
                  <Mail class="w-5 h-5" />
                </div>
                <div class="text-center">
                  <p class="font-medium">Email</p>
                  <p class="text-muted-foreground text-sm">alex@example.com</p>
                </div>
              </a>

              <a
                href="tel:+15551234567"
                class="flex flex-col items-center gap-4 p-6 border border-custom rounded-xl hover-bg-custom transition-all group"
              >
                <div
                  class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center text-white"
                >
                  <Phone class="w-5 h-5" />
                </div>
                <div class="text-center">
                  <p class="font-medium">Phone</p>
                  <p class="text-muted-foreground text-sm">+1 (555) 123-4567</p>
                </div>
              </a>
            </div>

            <div
              class="flex items-center gap-4 p-4 border border-custom rounded-xl mb-8"
            >
              <div
                class="w-12 h-12 rounded-xl bg-gradient-to-br from-green-500 to-green-600 flex items-center justify-center text-white"
              >
                <MapPin class="w-5 h-5" />
              </div>
              <div class="flex-1 text-center">
                <p class="font-medium">Location</p>
                <p class="text-muted-foreground">San Francisco, CA</p>
              </div>
            </div>

            <!-- Schedule Meeting Button -->
            <Button
              class="w-full bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 border-none group mb-6 py-4"
            >
              <Calendar class="w-4 h-4 mr-2" />
              <span>Schedule a 30-minute consultation</span>
              <ArrowRight
                class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
              />
            </Button>
          </div>
        </div>

        <!-- Social Connect Card -->
        <div
          class="glass rounded-2xl p-[1px] overflow-hidden reveal reveal-delay-1"
        >
          <div
            class="absolute -inset-[1px] bg-gradient-to-r from-purple-500/20 via-orange-500/10 to-blue-500/20 blur-sm"
          >
          </div>
          <div class="card-bg rounded-2xl p-6 relative z-10">
            <h3 class="text-xl font-semibold mb-6 text-center">
              Connect on Social
            </h3>
            <div class="flex justify-center gap-6">
              <a
                href="https://github.com"
                class="flex items-center gap-3 p-4 border border-custom rounded-xl hover-bg-custom transition-colors group"
              >
                <Github class="w-5 h-5 text-orange-500" />
                <span class="font-medium">GitHub</span>
                <ArrowRight
                  class="w-4 h-4 text-muted-foreground transition-transform group-hover:translate-x-1"
                />
              </a>
              <a
                href="https://linkedin.com"
                class="flex items-center gap-3 p-4 border border-custom rounded-xl hover-bg-custom transition-colors group"
              >
                <Linkedin class="w-5 h-5 text-orange-500" />
                <span class="font-medium">LinkedIn</span>
                <ArrowRight
                  class="w-4 h-4 text-muted-foreground transition-transform group-hover:translate-x-1"
                />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
