---
import { Button } from "@/components/ui/button";
import {
  Mail,
  MapPin,
  Phone,
  Calendar,
  Github,
  Linkedin,
  ArrowRight,
} from "lucide-react";
---

<section id="contact" class="py-32 relative overflow-hidden bg-[#0D0D10]">
  <!-- Decorative elements -->
  <div
    class="absolute top-1/3 left-1/4 w-96 h-96 rounded-full bg-orange-500/5 blur-3xl parallax"
    data-speed="10"
  >
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-20 reveal">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Let's Work Together</h2>
        <div
          class="w-20 h-1 bg-gradient-to-r from-orange-500 to-orange-600 rounded-full mx-auto mb-8"
        >
        </div>
        <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
          Ready to bring your mobile app idea to life? Let's discuss your
          project
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12">
        <!-- Left Column - Contact Info -->
        <div class="space-y-8 reveal reveal-delay-1">
          <div class="glass rounded-2xl p-[1px] overflow-hidden">
            <div
              class="absolute -inset-[1px] bg-gradient-to-r from-transparent via-orange-500 to-transparent opacity-20 blur-sm"
            >
            </div>
            <div class="bg-[#0D0D10] rounded-2xl p-8 relative z-10">
              <h3 class="text-2xl font-semibold mb-6">Get in touch</h3>
              <p class="text-muted-foreground mb-8 leading-relaxed">
                I'm always excited to work on new projects and collaborate with
                amazing teams. Whether you have a specific project in mind or
                just want to chat about mobile development, I'd love to hear
                from you.
              </p>

              <div class="space-y-6">
                <a
                  href="mailto:alex@example.com"
                  class="flex items-center gap-6 p-4 border border-white/5 rounded-xl hover:bg-white/5 transition-colors hover-trigger group"
                >
                  <div
                    class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center text-white"
                  >
                    <Mail class="w-5 h-5" />
                  </div>
                  <div class="flex-1">
                    <p class="font-medium">Email</p>
                    <p class="text-muted-foreground">alex@example.com</p>
                  </div>
                  <ArrowRight
                    class="w-4 h-4 text-muted-foreground transition-transform group-hover:translate-x-1"
                  />
                </a>

                <a
                  href="tel:+15551234567"
                  class="flex items-center gap-6 p-4 border border-white/5 rounded-xl hover:bg-white/5 transition-colors hover-trigger group"
                >
                  <div
                    class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center text-white"
                  >
                    <Phone class="w-5 h-5" />
                  </div>
                  <div class="flex-1">
                    <p class="font-medium">Phone</p>
                    <p class="text-muted-foreground">+1 (555) 123-4567</p>
                  </div>
                  <ArrowRight
                    class="w-4 h-4 text-muted-foreground transition-transform group-hover:translate-x-1"
                  />
                </a>

                <div
                  class="flex items-center gap-6 p-4 border border-white/5 rounded-xl"
                >
                  <div
                    class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center text-white"
                  >
                    <MapPin class="w-5 h-5" />
                  </div>
                  <div>
                    <p class="font-medium">Location</p>
                    <p class="text-muted-foreground">San Francisco, CA</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column - Contact Options -->
        <div class="space-y-8 reveal reveal-delay-2">
          <!-- Schedule Meeting Card -->
          <div class="glass rounded-2xl p-[1px] overflow-hidden">
            <div
              class="absolute -inset-[1px] bg-gradient-to-r from-transparent via-orange-500 to-transparent opacity-20 blur-sm"
            >
            </div>
            <div class="bg-[#0D0D10] rounded-2xl relative z-10 overflow-hidden">
              <div
                class="p-8 bg-gradient-to-br from-orange-500/10 to-transparent"
              >
                <h3 class="text-xl font-semibold mb-2">Schedule a Meeting</h3>
                <p class="text-muted-foreground mb-6">
                  Book a 30-minute consultation to discuss your project
                </p>
                <Button
                  class="w-full bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 border-none hover-trigger group"
                >
                  <Calendar class="w-4 h-4 mr-2" />
                  <span>Book a Call</span>
                  <ArrowRight
                    class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
                  />
                </Button>
              </div>
            </div>
          </div>

          <!-- Social Connect Card -->
          <div class="glass rounded-2xl p-[1px] overflow-hidden">
            <div
              class="absolute -inset-[1px] bg-gradient-to-r from-transparent via-orange-500 to-transparent opacity-20 blur-sm"
            >
            </div>
            <div class="bg-[#0D0D10] rounded-2xl p-8 relative z-10">
              <h3 class="text-xl font-semibold mb-6">Connect on Social</h3>
              <div class="space-y-4">
                <a
                  href="https://github.com"
                  class="flex items-center gap-4 p-4 border border-white/5 rounded-xl hover:bg-white/5 transition-colors hover-trigger group"
                >
                  <Github class="w-5 h-5 text-orange-500" />
                  <span class="font-medium">GitHub</span>
                  <ArrowRight
                    class="w-4 h-4 ml-auto text-muted-foreground transition-transform group-hover:translate-x-1"
                  />
                </a>
                <a
                  href="https://linkedin.com"
                  class="flex items-center gap-4 p-4 border border-white/5 rounded-xl hover:bg-white/5 transition-colors hover-trigger group"
                >
                  <Linkedin class="w-5 h-5 text-orange-500" />
                  <span class="font-medium">LinkedIn</span>
                  <ArrowRight
                    class="w-4 h-4 ml-auto text-muted-foreground transition-transform group-hover:translate-x-1"
                  />
                </a>
              </div>
            </div>
          </div>

          <!-- Response Time Card -->
          <div class="glass rounded-2xl p-[1px] overflow-hidden">
            <div
              class="absolute -inset-[1px] bg-gradient-to-r from-transparent via-orange-500 to-transparent opacity-20 blur-sm"
            >
            </div>
            <div class="bg-[#0D0D10] rounded-2xl p-8 relative z-10">
              <div class="flex items-center gap-4 mb-4">
                <div class="w-3 h-3 rounded-full bg-green-500 animate-pulse">
                </div>
                <h3 class="text-xl font-semibold">Currently Available</h3>
              </div>
              <p class="text-muted-foreground">
                I typically respond to all inquiries within 24 hours. For urgent
                matters, please call directly.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
