---
import { Button } from "@/components/ui/button";
import {
  Mail,
  MapPin,
  Phone,
  Calendar,
  Github,
  Linkedin,
  ArrowRight,
  MessageCircle,
  Clock,
} from "lucide-react";
---

<section id="contact" class="py-32 relative overflow-hidden">
  <!-- Enhanced gradient background with orange theme -->
  <div
    class="absolute inset-0 bg-gradient-to-br from-orange-500/8 via-transparent to-amber-500/6"
  >
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-tl from-yellow-500/4 via-transparent to-orange-500/5"
  >
  </div>
  <div
    class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-gradient-to-br from-orange-500/12 to-amber-500/8 blur-3xl"
  >
  </div>
  <div
    class="absolute bottom-1/4 right-1/4 w-64 h-64 rounded-full bg-gradient-to-br from-yellow-500/8 to-orange-500/6 blur-3xl"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <div class="text-center mb-20 reveal">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">Let's Work Together</h2>
      <div
        class="w-20 h-1 bg-gradient-to-r from-orange-500 to-amber-600 rounded-full mx-auto mb-8"
      >
      </div>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        Ready to bring your web application idea to life? Let's discuss your
        project and create something amazing together.
      </p>
    </div>

    <!-- Rééquilibrage du layout -->
    <div class="grid lg:grid-cols-3 gap-8">
      <!-- Colonne principale - Contact Info -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Primary Contact Card -->
        <div class="glass rounded-3xl p-[1px] overflow-hidden reveal">
          <div
            class="absolute -inset-[1px] bg-gradient-to-r from-orange-500/20 via-amber-500/15 to-yellow-500/20 blur-sm"
          >
          </div>
          <div class="card-bg rounded-3xl p-8 md:p-10 relative z-10">
            <div class="grid md:grid-cols-2 gap-8">
              <!-- Contact Info -->
              <div class="space-y-6">
                <div>
                  <h3
                    class="text-2xl font-semibold mb-4 flex items-center gap-3"
                  >
                    <MessageCircle className="w-6 h-6 text-orange-500" />
                    Get in touch
                  </h3>
                  <p class="text-muted-foreground leading-relaxed">
                    I'm always excited to work on new projects and collaborate
                    with amazing teams. Whether you have a specific project in
                    mind or just want to chat about web development.
                  </p>
                </div>

                <div class="space-y-4">
                  <a
                    href="mailto:alex@example.com"
                    class="flex items-center gap-4 p-4 border border-custom rounded-xl hover-bg-custom transition-all group"
                  >
                    <div
                      class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center text-white"
                    >
                      <Mail className="w-5 h-5" />
                    </div>
                    <div class="flex-1">
                      <p class="font-medium">Email</p>
                      <p class="text-muted-foreground text-sm">
                        alex@example.com
                      </p>
                    </div>
                    <ArrowRight
                      className="w-4 h-4 text-muted-foreground transition-transform group-hover:translate-x-1"
                    />
                  </a>

                  <a
                    href="tel:+15551234567"
                    class="flex items-center gap-4 p-4 border border-custom rounded-xl hover-bg-custom transition-all group"
                  >
                    <div
                      class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center text-white"
                    >
                      <Phone className="w-5 h-5" />
                    </div>
                    <div class="flex-1">
                      <p class="font-medium">Phone</p>
                      <p class="text-muted-foreground text-sm">
                        +1 (555) 123-4567
                      </p>
                    </div>
                    <ArrowRight
                      className="w-4 h-4 text-muted-foreground transition-transform group-hover:translate-x-1"
                    />
                  </a>
                </div>
              </div>

              <!-- Response Time & Location -->
              <div class="space-y-6">
                <div
                  class="p-6 bg-gradient-to-br from-orange-500/10 to-amber-500/5 rounded-2xl border border-orange-500/20"
                >
                  <div class="flex items-center gap-3 mb-4">
                    <Clock className="w-5 h-5 text-orange-500" />
                    <h4 class="font-semibold">Quick Response</h4>
                  </div>
                  <p class="text-muted-foreground text-sm leading-relaxed">
                    I typically respond to all inquiries within 24 hours. For
                    urgent matters, please call directly.
                  </p>
                </div>

                <div
                  class="flex items-center gap-4 p-4 border border-custom rounded-xl"
                >
                  <div
                    class="w-12 h-12 rounded-xl bg-gradient-to-br from-yellow-500 to-yellow-600 flex items-center justify-center text-white"
                  >
                    <MapPin className="w-5 h-5" />
                  </div>
                  <div>
                    <p class="font-medium">Location</p>
                    <p class="text-muted-foreground text-sm">
                      San Francisco, CA
                    </p>
                    <p class="text-xs text-orange-500 mt-1">
                      Available for remote work
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Schedule Meeting Card -->
        <div
          class="glass rounded-2xl p-[1px] overflow-hidden reveal reveal-delay-1"
        >
          <div
            class="absolute -inset-[1px] bg-gradient-to-r from-amber-500/20 via-orange-500/15 to-yellow-500/20 blur-sm"
          >
          </div>
          <div class="card-bg rounded-2xl p-8 relative z-10">
            <div class="flex flex-col md:flex-row items-center gap-6">
              <div class="flex-1 text-center md:text-left">
                <h3 class="text-xl font-semibold mb-2">
                  Schedule a Consultation
                </h3>
                <p class="text-muted-foreground">
                  Book a 30-minute consultation to discuss your project
                  requirements and explore how we can work together.
                </p>
              </div>
              <Button
                className="bg-gradient-to-r from-orange-500 to-amber-600 hover:from-orange-600 hover:to-amber-700 border-none group px-8 py-4 shrink-0"
              >
                <Calendar className="w-4 h-4 mr-2" />
                <span>Book a Call</span>
                <ArrowRight
                  className="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
                />
              </Button>
            </div>
          </div>
        </div>
      </div>

      <!-- Colonne secondaire - Social & Additional Info -->
      <div class="lg:col-span-1 space-y-8">
        <!-- Social Connect Card -->
        <div
          class="glass rounded-2xl p-[1px] overflow-hidden reveal reveal-delay-2"
        >
          <div
            class="absolute -inset-[1px] bg-gradient-to-r from-yellow-500/20 via-orange-500/15 to-amber-500/20 blur-sm"
          >
          </div>
          <div class="card-bg rounded-2xl p-6 relative z-10">
            <h3 class="text-lg font-semibold mb-6 text-center">
              Connect on Social
            </h3>
            <div class="space-y-4">
              <a
                href="https://github.com"
                class="flex items-center gap-4 p-4 border border-custom rounded-xl hover-bg-custom transition-colors group"
              >
                <Github className="w-5 h-5 text-orange-500" />
                <div class="flex-1">
                  <span class="font-medium text-sm">GitHub</span>
                  <p class="text-xs text-muted-foreground">View my code</p>
                </div>
                <ArrowRight
                  className="w-4 h-4 text-muted-foreground transition-transform group-hover:translate-x-1"
                />
              </a>
              <a
                href="https://linkedin.com"
                class="flex items-center gap-4 p-4 border border-custom rounded-xl hover-bg-custom transition-colors group"
              >
                <Linkedin className="w-5 h-5 text-orange-500" />
                <div class="flex-1">
                  <span class="font-medium text-sm">LinkedIn</span>
                  <p class="text-xs text-muted-foreground">
                    Professional network
                  </p>
                </div>
                <ArrowRight
                  className="w-4 h-4 text-muted-foreground transition-transform group-hover:translate-x-1"
                />
              </a>
            </div>
          </div>
        </div>

        <!-- Project Inquiry Card -->
        <div
          class="glass rounded-2xl p-[1px] overflow-hidden reveal reveal-delay-3"
        >
          <div
            class="absolute -inset-[1px] bg-gradient-to-r from-orange-500/20 via-yellow-500/15 to-amber-500/20 blur-sm"
          >
          </div>
          <div class="card-bg rounded-2xl p-6 relative z-10">
            <h3 class="text-lg font-semibold mb-4">Services</h3>
            <div class="space-y-3 text-sm text-muted-foreground">
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-orange-500"></div>
                <span>Full Stack Development</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-amber-500"></div>
                <span>API Development</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-yellow-500"></div>
                <span>Technical Architecture</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-orange-600"></div>
                <span>Code Review & Optimization</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
