---
import { Github, Linkedin, Mail, ArrowUp } from "lucide-react";
---

<footer class="py-16 relative overflow-hidden border-t border-white/5">
  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row justify-between items-center gap-8">
        <!-- Logo and Copyright -->
        <div class="text-center md:text-left">
          <div class="text-2xl font-bold gradient-text mb-2">Alex Chen</div>
          <p class="text-sm text-muted-foreground">
            &copy; {new Date().getFullYear()} Alex Chen. All rights reserved.
          </p>
        </div>

        <!-- Navigation Links -->
        <div class="hidden md:flex items-center space-x-6">
          <a
            href="#hero"
            class="text-sm text-muted-foreground hover:text-white transition-colors hover-trigger"
            >Home</a
          >
          <a
            href="#about"
            class="text-sm text-muted-foreground hover:text-white transition-colors hover-trigger"
            >About</a
          >
          <a
            href="#skills"
            class="text-sm text-muted-foreground hover:text-white transition-colors hover-trigger"
            >Skills</a
          >
          <a
            href="#projects"
            class="text-sm text-muted-foreground hover:text-white transition-colors hover-trigger"
            >Projects</a
          >
          <a
            href="#contact"
            class="text-sm text-muted-foreground hover:text-white transition-colors hover-trigger"
            >Contact</a
          >
        </div>

        <!-- Social Links -->
        <div class="flex justify-center gap-6">
          <a
            href="https://github.com"
            class="text-muted-foreground hover:text-orange-500 transition-colors hover-trigger"
            aria-label="GitHub Profile"
          >
            <Github class="w-5 h-5" />
          </a>
          <a
            href="https://linkedin.com"
            class="text-muted-foreground hover:text-orange-500 transition-colors hover-trigger"
            aria-label="LinkedIn Profile"
          >
            <Linkedin class="w-5 h-5" />
          </a>
          <a
            href="mailto:alex@example.com"
            class="text-muted-foreground hover:text-orange-500 transition-colors hover-trigger"
            aria-label="Email Contact"
          >
            <Mail class="w-5 h-5" />
          </a>
        </div>
      </div>

      <!-- Back to Top -->
      <div class="flex justify-center mt-12">
        <a
          href="#hero"
          class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center hover:bg-white/5 transition-colors hover-trigger"
          aria-label="Back to top"
        >
          <ArrowUp class="w-5 h-5" />
        </a>
      </div>
    </div>
  </div>
</footer>
