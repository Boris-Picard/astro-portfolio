---
import { Github, Linkedin, Mail, ArrowUp, Heart } from "lucide-react";
---

<footer
  class="py-16 relative overflow-hidden border-t border-border/20"
  aria-labelledby="Informations complémentaires du site"
  role="contentinfo"
>
  <!-- Dégradés décoratifs -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-orange-500/8 via-transparent to-transparent"
  >
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-br from-orange-500/6 via-transparent to-amber-500/4"
  >
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-tl from-yellow-500/3 via-transparent to-orange-500/4"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <div
      class="grid md:grid-cols-3 gap-8 justify-center md:justify-between"
    >
      <!-- Identité & Présentation -->
      <div class="md:col-span-1">
        <h2 id="footer-title" class="sr-only">Pied de page du site</h2>
        <div class="text-2xl font-bold mb-4">
          <span
            class="bg-gradient-to-r from-orange-500 via-amber-400 to-yellow-500 bg-clip-text text-transparent"
          >
            Boris Picard
          </span>
        </div>
        <p class="text-muted-foreground text-sm leading-relaxed mb-6">
          Développeur full-stack passionné par la création d’expériences web
          soignées et efficaces. J’aime concevoir des solutions robustes et
          accessibles pour répondre aux vrais besoins.
        </p>
        <div class="flex items-center gap-2 text-sm text-muted-foreground">
          <span>Réalisé avec</span>
          <Heart
            className="w-4 h-4 text-orange-500 fill-current"
            aria-hidden="true"
          />
          <span>depuis Strasbourg</span>
        </div>
      </div>

      <!-- Liens de navigation -->
      <nav class="md:col-span-1" aria-label="Liens vers les sections principales du site">
        <h3 class="font-semibold experience-title mb-4">Navigation</h3>
        <div class="space-y-3">
          <a
            href="#about"
            class="block text-sm text-muted-foreground hover:text-orange-500 transition-colors"
          >
            À propos
          </a>
          <a
            href="#projects"
            class="block text-sm text-muted-foreground hover:text-amber-500 transition-colors"
          >
            Projets
          </a>
          <a
            href="#skills"
            class="block text-sm text-muted-foreground hover:text-yellow-500 transition-colors"
          >
            Compétences
          </a>
          <a
            href="#contact"
            class="block text-sm text-muted-foreground hover:text-orange-600 transition-colors"
          >
            Contact
          </a>
        </div>
      </nav>

      <!-- Coordonnées & Réseaux -->
      <section
        class="md:col-span-1"
        aria-label="Coordonnées et réseaux sociaux"
      >
        <h3 class="font-semibold experience-title mb-4">Réseaux</h3>
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <Mail className="w-4 h-4 text-orange-500" aria-hidden="true" />
            <a
              href="mailto:boris.picard@outlook.fr"
              aria-label="Envoyer un email à Boris Picard"
              target="_blank" rel="noopener noreferrer"
              class="text-sm text-muted-foreground hover:text-orange-500 transition-colors"
            >
              boris.picard@outlook.fr
            </a>
          </div>
          <div class="flex items-center gap-3">
            <Linkedin className="w-4 h-4 text-amber-500" aria-hidden="true" />
            <a
              href="https://linkedin.com/in/boris-picard-2906029b"
              target="_blank" rel="noopener noreferrer"
              aria-label="Profil LinkedIn de Boris Picard"
              class="text-sm text-muted-foreground hover:text-amber-500 transition-colors"
            >
              linkedin.com/in/boris-picard
            </a>
          </div>
          <div class="flex items-center gap-3">
            <Github className="w-4 h-4 text-yellow-500" aria-hidden="true" />
            <a
              href="https://github.com/Boris-Picard"
              aria-label="Profil GitHub de Boris Picard"
              target="_blank" rel="noopener noreferrer"
              class="text-sm text-muted-foreground hover:text-yellow-500 transition-colors"
            >
              github.com/Boris-Picard
            </a>
          </div>
        </div>
      </section>
    </div>

    <!-- Bas de page -->
    <div
      class="flex flex-col md:flex-row justify-between items-center gap-4 mt-12 pt-8 border-t border-border/20"
    >
      <p class="text-sm text-muted-foreground">
        &copy; {new Date().getFullYear()} Boris Picard. Tous droits réservés.
      </p>
      <a
        href="#hero"
        class="flex items-center gap-2 text-sm text-muted-foreground hover:text-orange-500 transition-colors group"
        aria-label="Retour en haut de page"
      >
        <span>Retour en haut</span>
        <ArrowUp
          className="w-4 h-4 transition-transform group-hover:-translate-y-1"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>
</footer>
