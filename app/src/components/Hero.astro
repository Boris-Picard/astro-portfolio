---
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { ArrowDown, Github, Linkedin, Mail, ChevronRight } from "lucide-react";
---

<section
  id="hero"
  class="min-h-screen flex items-center justify-center relative overflow-hidden pt-20"
>
  <!-- Decorative elements -->
  <div
    class="absolute top-1/4 left-1/4 w-64 h-64 rounded-full bg-orange-500/5 blur-3xl parallax"
    data-speed="20"
  >
  </div>
  <div
    class="absolute bottom-1/3 right-1/4 w-96 h-96 rounded-full bg-orange-500/5 blur-3xl parallax"
    data-speed="10"
  >
  </div>

  <!-- Decorative grid -->
  <div
    class="absolute inset-0 grid grid-cols-6 grid-rows-6 pointer-events-none"
  >
    {
      Array(36)
        .fill(0)
        .map((_, i) => <div class="border-[0.5px] border-white/[0.02]" />)
    }
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-5xl mx-auto">
      <div
        class="flex flex-col items-center md:items-start text-center md:text-left"
      >
        <Badge
          variant="outline"
          class="mb-6 border-orange-500/20 text-orange-500 reveal reveal-delay-1"
        >
          Mobile App Developer
        </Badge>

        <h1
          class="text-5xl md:text-7xl lg:text-8xl font-bold mb-6 leading-tight reveal reveal-delay-2"
        >
          Creating <span class="gradient-text">exceptional</span> mobile experiences
        </h1>

        <p
          class="text-xl text-muted-foreground mb-8 max-w-2xl reveal reveal-delay-3"
        >
          I'm <span class="text-white font-medium">Alex Chen</span>, a mobile
          application developer specializing in crafting high-performance,
          user-centered apps for iOS and Android platforms.
        </p>

        <div
          class="flex flex-col sm:flex-row gap-4 mb-12 reveal reveal-delay-4"
        >
          <Button
            size="lg"
            class="bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 border-none rounded-full px-8 py-6 hover-trigger group"
          >
            <span>Get In Touch</span>
            <ChevronRight
              class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
            />
          </Button>
          <Button
            variant="outline"
            size="lg"
            class="border-white/10 hover:bg-white/5 rounded-full px-8 py-6 hover-trigger"
          >
            View My Work
          </Button>
        </div>

        <div class="flex items-center gap-8 reveal reveal-delay-4">
          <div class="flex items-center gap-2">
            <div class="w-1 h-1 rounded-full bg-orange-500"></div>
            <span class="text-sm text-muted-foreground"
              >Based in San Francisco</span
            >
          </div>
          <div class="flex items-center gap-2">
            <div class="w-1 h-1 rounded-full bg-orange-500"></div>
            <span class="text-sm text-muted-foreground"
              >Available for freelance</span
            >
          </div>
        </div>
      </div>

      <!-- Floating tech stack -->
      <div
        class="absolute bottom-20 right-0 hidden lg:flex flex-col items-end gap-4"
      >
        <div class="flex items-center gap-3 text-sm text-muted-foreground">
          <span>Tech Stack</span>
          <div class="w-10 h-[1px] bg-white/10"></div>
        </div>
        <div class="flex gap-4">
          <div
            class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover-trigger"
          >
            <span class="text-xs font-medium">RN</span>
          </div>
          <div
            class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover-trigger"
          >
            <span class="text-xs font-medium">FL</span>
          </div>
          <div
            class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover-trigger"
          >
            <span class="text-xs font-medium">iOS</span>
          </div>
          <div
            class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center hover-trigger"
          >
            <span class="text-xs font-medium">AND</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Social links -->
  <div
    class="absolute left-4 md:left-10 bottom-10 flex flex-col gap-6 items-center"
  >
    <a
      href="https://github.com"
      class="text-muted-foreground hover:text-orange-500 transition-colors hover-trigger"
      aria-label="GitHub Profile"
    >
      <Github class="w-5 h-5" />
    </a>
    <a
      href="https://linkedin.com"
      class="text-muted-foreground hover:text-orange-500 transition-colors hover-trigger"
      aria-label="LinkedIn Profile"
    >
      <Linkedin class="w-5 h-5" />
    </a>
    <a
      href="mailto:alex@example.com"
      class="text-muted-foreground hover:text-orange-500 transition-colors hover-trigger"
      aria-label="Email Contact"
    >
      <Mail class="w-5 h-5" />
    </a>
    <div class="w-[1px] h-20 bg-white/10"></div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-10 left-1/2 transform -translate-x-1/2 flex flex-col items-center gap-2"
  >
    <span class="text-xs text-muted-foreground">Scroll Down</span>
    <div
      class="w-5 h-10 rounded-full border border-white/10 flex items-center justify-center"
    >
      <div class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-bounce"></div>
    </div>
  </div>
</section>
