---
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { ChevronRight, Github, Linkedin, Mail } from "lucide-react";
---

<section
  id="hero"
  class="min-h-screen flex items-center justify-center relative overflow-hidden"
>
  <!-- Enhanced 2025-inspired gradient background -->
  <div class="absolute inset-0">
    <!-- Primary gradient layer -->
    <div
      class="absolute inset-0 bg-gradient-to-br from-orange-500/10 via-transparent to-purple-500/5"
    >
    </div>
    <!-- Mesh gradient overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-tr from-blue-500/5 via-transparent to-pink-500/5"
    >
    </div>
    <!-- Radial gradients for depth -->
    <div
      class="absolute top-0 left-0 w-full h-full bg-radial-gradient from-orange-500/8 via-transparent to-transparent"
    >
    </div>
    <!-- Animated gradient orbs -->
    <div
      class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-gradient-to-br from-orange-500/15 via-orange-400/5 to-transparent blur-3xl animate-pulse"
    >
    </div>
    <div
      class="absolute bottom-1/3 right-1/4 w-64 h-64 rounded-full bg-gradient-to-tl from-purple-500/10 via-blue-500/5 to-transparent blur-3xl animate-pulse delay-1000"
    >
    </div>
  </div>

  <!-- Decorative elements -->
  <div
    class="absolute top-1/4 left-1/4 w-64 h-64 rounded-full bg-orange-500/10 blur-3xl parallax"
    data-speed="20"
  >
  </div>
  <div
    class="absolute bottom-1/3 right-1/4 w-96 h-96 rounded-full bg-orange-500/5 blur-3xl parallax"
    data-speed="10"
  >
  </div>

  <!-- Decorative grid -->
  <div
    class="absolute inset-0 grid grid-cols-6 grid-rows-6 pointer-events-none opacity-20"
  >
    {
      Array(36)
        .fill(0)
        .map((_, i) => <div class="border-[0.5px] border-orange-500/[0.02]" />)
    }
  </div>

  <!-- Fixed container to prevent layout shift -->
  <div class="container mx-auto px-4 relative z-10 w-full">
    <div
      class="max-w-5xl mx-auto min-h-[calc(100vh-8rem)] flex items-center justify-center"
    >
      <div class="flex flex-col items-center text-center w-full">
        <Badge
          variant="outline"
          class="mb-6 border-orange-500/30 text-orange-500 bg-orange-500/5 reveal reveal-delay-1"
        >
          Mobile App Developer
        </Badge>

        <h1
          class="text-4xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight reveal reveal-delay-2"
        >
          Creating <span class="gradient-text">exceptional</span><br />
          mobile experiences
        </h1>

        <p
          class="text-lg md:text-xl text-foreground/80 mb-8 max-w-2xl reveal reveal-delay-3"
        >
          I'm <span class="text-orange-500 font-medium">Alex Chen</span>, a
          mobile application developer specializing in crafting
          high-performance, user-centered apps for iOS and Android platforms.
        </p>

        <div
          class="flex flex-col sm:flex-row gap-4 mb-12 reveal reveal-delay-4"
        >
          <Button
            size="lg"
            class="bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 border-none rounded-full px-8 py-6 group"
          >
            <span>Get In Touch</span>
            <ChevronRight
              class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
            />
          </Button>
          <Button
            variant="outline"
            size="lg"
            class="border-orange-500/20 hover:bg-orange-500/10 hover:text-orange-500 rounded-full px-8 py-6"
          >
            View My Work
          </Button>
        </div>

        <!-- Social Links -->
        <div class="flex flex-col items-center gap-6 reveal reveal-delay-4">
          <div class="flex items-center gap-2 text-sm text-foreground/60">
            <div class="w-8 h-[1px] bg-orange-500/30"></div>
            <span>Follow me</span>
            <div class="w-8 h-[1px] bg-orange-500/30"></div>
          </div>

          <div class="flex items-center gap-6">
            <a
              href="https://github.com"
              class="group flex items-center justify-center w-12 h-12 rounded-full bg-orange-500/5 hover:bg-orange-500/10 transition-all duration-300"
              aria-label="GitHub Profile"
            >
              <Github
                class="w-5 h-5 text-foreground/60 group-hover:text-orange-500 transition-colors"
              />
            </a>
            <a
              href="https://linkedin.com"
              class="group flex items-center justify-center w-12 h-12 rounded-full bg-orange-500/5 hover:bg-orange-500/10 transition-all duration-300"
              aria-label="LinkedIn Profile"
            >
              <Linkedin
                class="w-5 h-5 text-foreground/60 group-hover:text-orange-500 transition-colors"
              />
            </a>
            <a
              href="mailto:alex@example.com"
              class="group flex items-center justify-center w-12 h-12 rounded-full bg-orange-500/5 hover:bg-orange-500/10 transition-all duration-300"
              aria-label="Email Contact"
            >
              <Mail
                class="w-5 h-5 text-foreground/60 group-hover:text-orange-500 transition-colors"
              />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
