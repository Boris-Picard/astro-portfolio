---
import { Button } from "@/components/ui/button";
import { ThemeToggle } from "@/components/ui/theme-toggle";
import { Menu, X } from "lucide-react";
---

<header class="fixed top-0 left-0 right-0 z-50 glass border-b border-border/20">
  <div class="max-w-7xl mx-auto px-4">
    <nav class="flex items-center justify-between h-20 md:h-24">
      <!-- Logo -->
      <a href="#" class="text-xl font-bold relative group z-50">
        <span class="gradient-text text-2xl font-bold">Alex Chen</span>
        <div
          class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gradient-to-r from-orange-500 to-orange-600 transition-all duration-300 group-hover:w-full"
        >
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center space-x-8">
        <a
          href="#hero"
          class="nav-link relative text-sm font-medium transition-colors hover:text-orange-500"
        >
          <span>Home</span>
          <div class="nav-indicator"></div>
        </a>
        <a
          href="#about"
          class="nav-link relative text-sm font-medium transition-colors hover:text-orange-500"
        >
          <span>About</span>
          <div class="nav-indicator"></div>
        </a>
        <a
          href="#skills"
          class="nav-link relative text-sm font-medium transition-colors hover:text-orange-500"
        >
          <span>Skills</span>
          <div class="nav-indicator"></div>
        </a>
        <a
          href="#projects"
          class="nav-link relative text-sm font-medium transition-colors hover:text-orange-500"
        >
          <span>Projects</span>
          <div class="nav-indicator"></div>
        </a>
        <a
          href="#contact"
          class="nav-link relative text-sm font-medium transition-colors hover:text-orange-500"
        >
          <span>Contact</span>
          <div class="nav-indicator"></div>
        </a>
      </div>

      <!-- Right side actions -->
      <div class="flex items-center gap-4">
        <!-- Theme Toggle -->
        <ThemeToggle client:load />

        <!-- CTA Button -->
        <div class="hidden lg:block">
          <Button
            className="bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 border-none rounded-full px-6"
          >
            Download CV
          </Button>
        </div>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-trigger"
          class="lg:hidden relative w-10 h-10 flex items-center justify-center bg-background/80 backdrop-blur-sm hover:bg-background transition-colors z-50"
          aria-label="Open navigation menu"
        >
          <Menu
            id="menu-icon"
            className="absolute inset-0 m-auto w-5 h-5 text-foreground transition-opacity duration-200"
          />
          <X
            id="close-icon"
            className="absolute inset-0 m-auto w-5 h-5 text-foreground transition-opacity duration-200"
          />
        </button>
      </div>
    </nav>
  </div>
</header>

<!-- Mobile Navigation Overlay -->
<div
  id="mobile-overlay"
  class="lg:hidden fixed inset-0 z-40 bg-background/95 backdrop-blur-md opacity-0 invisible transition-all duration-300 ease-in-out"
>
  <!-- Mobile Navigation Content -->
  <div class="flex flex-col h-full">
    <!-- Header Space -->
    <div class="h-20 md:h-24"></div>

    <!-- Navigation Content -->
    <div class="flex-1 flex flex-col justify-center px-8">
      <!-- Navigation Links -->
      <nav class="space-y-6">
        <a
          href="#hero"
          class="mobile-nav-link group flex items-center justify-between py-4 text-2xl md:text-3xl font-medium text-foreground hover:text-orange-500 transition-all duration-300 border-b border-border/20 hover:border-orange-500/30"
        >
          <div class="flex items-center gap-4">
            <span class="text-orange-500 text-lg font-mono">01</span>
            <span>Home</span>
          </div>
          <svg
            class="w-6 h-6 opacity-0 group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </a>

        <a
          href="#about"
          class="mobile-nav-link group flex items-center justify-between py-4 text-2xl md:text-3xl font-medium text-foreground hover:text-orange-500 transition-all duration-300 border-b border-border/20 hover:border-orange-500/30"
        >
          <div class="flex items-center gap-4">
            <span class="text-orange-500 text-lg font-mono">02</span>
            <span>About</span>
          </div>
          <svg
            class="w-6 h-6 opacity-0 group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </a>

        <a
          href="#skills"
          class="mobile-nav-link group flex items-center justify-between py-4 text-2xl md:text-3xl font-medium text-foreground hover:text-orange-500 transition-all duration-300 border-b border-border/20 hover:border-orange-500/30"
        >
          <div class="flex items-center gap-4">
            <span class="text-orange-500 text-lg font-mono">03</span>
            <span>Skills</span>
          </div>
          <svg
            class="w-6 h-6 opacity-0 group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </a>

        <a
          href="#projects"
          class="mobile-nav-link group flex items-center justify-between py-4 text-2xl md:text-3xl font-medium text-foreground hover:text-orange-500 transition-all duration-300 border-b border-border/20 hover:border-orange-500/30"
        >
          <div class="flex items-center gap-4">
            <span class="text-orange-500 text-lg font-mono">04</span>
            <span>Projects</span>
          </div>
          <svg
            class="w-6 h-6 opacity-0 group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </a>

        <a
          href="#contact"
          class="mobile-nav-link group flex items-center justify-between py-4 text-2xl md:text-3xl font-medium text-foreground hover:text-orange-500 transition-all duration-300 border-b border-border/20 hover:border-orange-500/30"
        >
          <div class="flex items-center gap-4">
            <span class="text-orange-500 text-lg font-mono">05</span>
            <span>Contact</span>
          </div>
          <svg
            class="w-6 h-6 opacity-0 group-hover:opacity-100 group-hover:translate-x-2 transition-all duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </nav>

      <!-- CTA Button -->
      <div class="mt-12">
        <Button
          className="w-full bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 border-none rounded-lg py-4 text-lg font-medium shadow-lg"
        >
          Download CV
        </Button>
      </div>
    </div>

    <!-- Footer -->
    <div class="p-8 border-t border-border/20">
      <p class="text-sm text-muted-foreground text-center">
        Let's create something amazing together
      </p>
    </div>
  </div>
</div>

<script>
  // Mobile navigation functionality
  const mobileMenuTrigger = document.getElementById("mobile-menu-trigger");
  const mobileOverlay = document.getElementById("mobile-overlay");
  const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");
  const menuIcon = document.getElementById("menu-icon");
  const closeIcon = document.getElementById("close-icon");
  const body = document.body;

  let isOpen = false;

  function openMobileMenu() {
    isOpen = true;
    mobileOverlay?.classList.add("open");
    mobileMenuTrigger?.classList.add("open");
    body.style.overflow = "hidden";
  }

  function closeMobileMenu() {
    isOpen = false;
    mobileOverlay?.classList.remove("open");
    mobileMenuTrigger?.classList.remove("open");
    body.style.overflow = "auto";
  }

  function toggleMobileMenu() {
    if (isOpen) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  }

  // Event listeners
  mobileMenuTrigger?.addEventListener("click", toggleMobileMenu);

  // Close menu when clicking on navigation links
  mobileNavLinks.forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });

  // Close menu when clicking on overlay background
  mobileOverlay?.addEventListener("click", (e) => {
    if (e.target === mobileOverlay) {
      closeMobileMenu();
    }
  });

  // Close menu on escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen) {
      closeMobileMenu();
    }
  });

  // Active link indicator for desktop
  const sections = document.querySelectorAll("section[id]");
  const navLinks = document.querySelectorAll(".nav-link");

  function highlightNavLink() {
    const scrollY = window.scrollY;

    sections.forEach((section) => {
      const sectionHeight = section.offsetHeight;
      const sectionTop = section.offsetTop - 100;
      const sectionId = section.getAttribute("id");

      if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
        navLinks.forEach((link) => {
          link.classList.remove("active");
          if (link.getAttribute("href") === `#${sectionId}`) {
            link.classList.add("active");
          }
        });
      }
    });
  }

  window.addEventListener("scroll", highlightNavLink);

  // Initialize
  document.addEventListener("DOMContentLoaded", () => {
    highlightNavLink();
  });
</script>
