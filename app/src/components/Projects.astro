---
import { projects } from "@/data/projects";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Github, ExternalLink, ArrowRight } from "lucide-react";
---

<section id="projects" class="py-32 relative overflow-hidden">
  <div
    class="absolute inset-0 bg-gradient-to-bl from-orange-500/6 via-transparent to-amber-500/4"
  >
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-tr from-yellow-500/3 via-transparent to-orange-500/5"
  >
  </div>
  <div
    class="absolute bottom-1/4 left-1/3 w-96 h-96 rounded-full bg-gradient-to-tr from-orange-500/10 via-amber-500/6 to-transparent blur-3xl"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <!-- Header -->
    <div class="text-center mb-20 reveal">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Featured Projects</h2>
      <div
        class="w-20 h-1 bg-gradient-to-r from-orange-500 to-amber-600 rounded-full mx-auto mb-8"
      >
      </div>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        A showcase of web applications I've built
      </p>
    </div>

    <!-- Projects List -->
    <div class="space-y-32">
      {
        projects.map((proj, idx) => {
          const isFirst = idx % 2 === 0;
          return (
            <div class="mb-32 reveal">
              <div class="grid md:grid-cols-2 gap-16 items-center">
                {/* Text block */}
                <div
                  class={`space-y-6 ${isFirst ? "md:order-1" : "md:order-2"}`}
                >
                  <div class="space-y-4">
                    <Badge
                      variant="outline"
                      className="px-4 py-2"
                      style={{
                        borderColor: proj.theme.border,
                        color: proj.theme.primary,
                        backgroundColor: proj.theme.light,
                      }}
                    >
                      {proj.type} Project
                    </Badge>
                    <h3 class="text-2xl md:text-3xl font-bold leading-tight">
                      {proj.title}
                    </h3>
                  </div>
                  <p class="text-muted-foreground leading-relaxed text-lg">
                    {proj.description}
                  </p>
                  <div class="flex flex-wrap gap-3">
                    {proj.techs.map((tech) => (
                      <Badge
                        className="px-4 py-2 border"
                        style={{
                          backgroundColor: proj.techColors[tech].bgColor,
                          color: proj.techColors[tech].color,
                          borderColor: proj.techColors[tech].borderColor,
                        }}
                      >
                        {tech}
                      </Badge>
                    ))}
                  </div>
                  <div class="flex gap-4 pt-2">
                    {proj.github &&
                      proj.github.map(({ name, link }) => (
                        <a href={link} target="_blank">
                          <Button
                            variant="outline"
                            className="group transition-colors cursor-pointer rounded-full"
                            style={{
                              borderColor: proj.theme.border,
                            }}
                          >
                            <Github className="w-4 h-4 mr-2" />
                            <span>{name}</span>
                          </Button>
                        </a>
                      ))}
                    {proj.site &&
                      proj.site.map(({ name, link }) => (
                        <a href={link} target="_blank">
                          <Button
                            className="text-white border-none group cursor-pointer rounded-full hover:opacity-90 transition-opacity"
                            style={{
                              background: proj.theme.gradient,
                            }}
                          >
                            <span>{name}</span>
                            <ExternalLink className="w-4 h-4 ml-2" />
                          </Button>
                        </a>
                      ))}
                  </div>
                </div>

                {/* Image block */}
                <div class={isFirst ? "md:order-2" : "md:order-1"}>
                  <div
                    class="project-card aspect-[4/3] rounded-2xl p-1 relative overflow-hidden border"
                    style={{
                      borderColor: proj.theme.border,
                    }}
                  >
                    <div
                      class="absolute -inset-[1px] opacity-20 blur-sm"
                      style={{
                        background: `linear-gradient(to right, transparent, ${proj.theme.primary}, transparent)`,
                      }}
                    />
                    <div class="w-full h-full card-bg rounded-2xl relative overflow-hidden">
                      <img
                        src={proj.image}
                        alt={proj.title}
                        class="w-full h-full object-cover"
                      />
                      <div
                        class="absolute inset-0"
                        style={{
                          background: `linear-gradient(to bottom right, ${proj.theme.light}, rgba(0,0,0,0.02))`,
                        }}
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- View All Projects Button -->
    <div class="text-center mt-16 reveal">
      <Button
        variant="outline"
        size="lg"
        className="border-orange-500/20 hover:bg-orange-500/10 hover:text-orange-500 rounded-full px-8 py-6 group"
      >
        <span>View All Projects</span>
        <ArrowRight
          className="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
        />
      </Button>
    </div>
  </div>
</section>
