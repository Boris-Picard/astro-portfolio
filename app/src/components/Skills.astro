---
import * as Icons from "lucide-react";
import { skills } from "@/data/skills";
---

<section id="skills" class="py-32 relative overflow-hidden section-alt">
  <!-- Background -->
  <div
    class="absolute inset-0 bg-gradient-to-tl from-orange-500/6 via-transparent to-amber-500/4"
  >
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-br from-yellow-500/3 via-transparent to-orange-500/5"
  >
  </div>
  <div
    class="absolute top-1/4 right-1/3 w-96 h-96 rounded-full bg-gradient-to-br from-orange-500/10 to-amber-500/6 blur-3xl"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <!-- Header -->
    <div class="text-center mb-20 reveal">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Skills & Expertise</h2>
      <div
        class="w-20 h-1 bg-gradient-to-r from-orange-500 to-amber-600 rounded-full mx-auto mb-8"
      >
      </div>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        Technologies and tools I use to bring ideas to life
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        skills.map((cat, idx) => {
          const IconComponent = (Icons as any)[cat.icon];
          const delay = (idx % 3) + 1;
          return (
            <div
              class={`glass rounded-2xl p-[1px] overflow-hidden reveal reveal-delay-${delay}`}
            >
              <div
                class={`absolute -inset-[1px] bg-gradient-to-r from-transparent via-${cat.theme}-400 to-transparent opacity-20 blur-sm`}
              />
              <div
                class={`card-bg rounded-2xl p-8 relative z-10 h-full border-${cat.theme}-500/10`}
              >
                <div class="flex items-center gap-4 mb-6">
                  <div
                    class={`w-12 h-12 rounded-xl bg-gradient-to-br from-${cat.theme}-400 to-${cat.theme}-500 flex items-center justify-center shadow-lg`}
                  >
                    <IconComponent class="w-6 h-6 text-white" />
                  </div>
                  <div>
                    <h3 class="text-xl font-semibold">{cat.title}</h3>
                    <p class="text-sm text-muted-foreground">
                      {cat.subtitle}
                    </p>
                  </div>
                </div>
                <div class="space-y-3">
                  {cat.items.map((item) => (
                    <div
                      class={`flex items-center justify-between p-3 bg-muted-custom rounded-lg border border-${cat.theme}-500/10 hover:border-${cat.theme}-500/20 transition-colors group`}
                    >
                      <div class="flex items-center gap-3">
                        <div
                          style={{ backgroundColor: item.bgColor }}
                          class="w-6 h-6 rounded flex items-center justify-center text-xs font-bold text-white"
                        >
                          {item.icon}
                        </div>
                        <span class="text-sm font-medium">
                          {item.label}
                        </span>
                      </div>
                      <div
                        class={`w-2 h-2 rounded-full bg-${cat.theme}-400 group-hover:scale-125 transition-transform`}
                      />
                    </div>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
