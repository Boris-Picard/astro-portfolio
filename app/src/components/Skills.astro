---
import { Smartphone, Code, Palette, Database, Cloud, Zap } from "lucide-react";
---

<section id="skills" class="py-32 relative overflow-hidden section-alt">
  <!-- Enhanced gradient background -->
  <div
    class="absolute inset-0 bg-gradient-to-tl from-blue-500/5 via-transparent to-orange-500/3"
  >
  </div>
  <div
    class="absolute top-1/4 right-1/3 w-96 h-96 rounded-full bg-gradient-to-br from-orange-500/8 to-blue-500/5 blur-3xl"
  >
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-20 reveal">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Skills & Expertise</h2>
        <div
          class="w-20 h-1 bg-gradient-to-r from-orange-500 to-orange-600 rounded-full mx-auto mb-8"
        >
        </div>
        <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
          Technologies and tools I use to bring ideas to life
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Mobile Development -->
        <div
          class="glass rounded-2xl p-[1px] overflow-hidden reveal reveal-delay-1"
        >
          <div
            class="absolute -inset-[1px] bg-gradient-to-r from-transparent via-orange-500 to-transparent opacity-20 blur-sm"
          >
          </div>
          <div class="card-bg rounded-2xl p-8 relative z-10 h-full">
            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center"
              >
                <Smartphone class="w-6 h-6 text-white" />
              </div>
              <div>
                <h3 class="text-xl font-semibold">Mobile Development</h3>
                <p class="text-sm text-muted-foreground">
                  Cross-platform & Native
                </p>
              </div>
            </div>

            <div class="space-y-3">
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">React Native</span>
                <div class="w-2 h-2 rounded-full bg-orange-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">Flutter</span>
                <div class="w-2 h-2 rounded-full bg-orange-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">Swift/SwiftUI</span>
                <div class="w-2 h-2 rounded-full bg-orange-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">Kotlin</span>
                <div class="w-2 h-2 rounded-full bg-orange-500"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Frontend Development -->
        <div
          class="glass rounded-2xl p-[1px] overflow-hidden reveal reveal-delay-2"
        >
          <div
            class="absolute -inset-[1px] bg-gradient-to-r from-transparent via-blue-500 to-transparent opacity-20 blur-sm"
          >
          </div>
          <div class="card-bg rounded-2xl p-8 relative z-10 h-full">
            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center"
              >
                <Code class="w-6 h-6 text-white" />
              </div>
              <div>
                <h3 class="text-xl font-semibold">Frontend Development</h3>
                <p class="text-sm text-muted-foreground">
                  Modern Web Technologies
                </p>
              </div>
            </div>

            <div class="space-y-3">
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">React</span>
                <div class="w-2 h-2 rounded-full bg-blue-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">TypeScript</span>
                <div class="w-2 h-2 rounded-full bg-blue-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">Next.js</span>
                <div class="w-2 h-2 rounded-full bg-blue-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">Tailwind CSS</span>
                <div class="w-2 h-2 rounded-full bg-blue-500"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- UI/UX Design -->
        <div
          class="glass rounded-2xl p-[1px] overflow-hidden reveal reveal-delay-3"
        >
          <div
            class="absolute -inset-[1px] bg-gradient-to-r from-transparent via-purple-500 to-transparent opacity-20 blur-sm"
          >
          </div>
          <div class="card-bg rounded-2xl p-8 relative z-10 h-full">
            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center"
              >
                <Palette class="w-6 h-6 text-white" />
              </div>
              <div>
                <h3 class="text-xl font-semibold">UI/UX Design</h3>
                <p class="text-sm text-muted-foreground">
                  Design & Prototyping
                </p>
              </div>
            </div>

            <div class="space-y-3">
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">Figma</span>
                <div class="w-2 h-2 rounded-full bg-purple-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">Adobe XD</span>
                <div class="w-2 h-2 rounded-full bg-purple-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">Sketch</span>
                <div class="w-2 h-2 rounded-full bg-purple-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">Principle</span>
                <div class="w-2 h-2 rounded-full bg-purple-500"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Backend & Database -->
        <div
          class="glass rounded-2xl p-[1px] overflow-hidden reveal reveal-delay-1"
        >
          <div
            class="absolute -inset-[1px] bg-gradient-to-r from-transparent via-green-500 to-transparent opacity-20 blur-sm"
          >
          </div>
          <div class="card-bg rounded-2xl p-8 relative z-10 h-full">
            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 rounded-xl bg-gradient-to-br from-green-500 to-green-600 flex items-center justify-center"
              >
                <Database class="w-6 h-6 text-white" />
              </div>
              <div>
                <h3 class="text-xl font-semibold">Backend & Database</h3>
                <p class="text-sm text-muted-foreground">
                  Server & Data Management
                </p>
              </div>
            </div>

            <div class="space-y-3">
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">Node.js</span>
                <div class="w-2 h-2 rounded-full bg-green-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">Firebase</span>
                <div class="w-2 h-2 rounded-full bg-green-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">MongoDB</span>
                <div class="w-2 h-2 rounded-full bg-green-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">PostgreSQL</span>
                <div class="w-2 h-2 rounded-full bg-green-500"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Cloud & DevOps -->
        <div
          class="glass rounded-2xl p-[1px] overflow-hidden reveal reveal-delay-2"
        >
          <div
            class="absolute -inset-[1px] bg-gradient-to-r from-transparent via-cyan-500 to-transparent opacity-20 blur-sm"
          >
          </div>
          <div class="card-bg rounded-2xl p-8 relative z-10 h-full">
            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 rounded-xl bg-gradient-to-br from-cyan-500 to-cyan-600 flex items-center justify-center"
              >
                <Cloud class="w-6 h-6 text-white" />
              </div>
              <div>
                <h3 class="text-xl font-semibold">Cloud & DevOps</h3>
                <p class="text-sm text-muted-foreground">
                  Deployment & Infrastructure
                </p>
              </div>
            </div>

            <div class="space-y-3">
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">AWS</span>
                <div class="w-2 h-2 rounded-full bg-cyan-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">Docker</span>
                <div class="w-2 h-2 rounded-full bg-cyan-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">CI/CD</span>
                <div class="w-2 h-2 rounded-full bg-cyan-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">Vercel</span>
                <div class="w-2 h-2 rounded-full bg-cyan-500"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tools & Workflow -->
        <div
          class="glass rounded-2xl p-[1px] overflow-hidden reveal reveal-delay-3"
        >
          <div
            class="absolute -inset-[1px] bg-gradient-to-r from-transparent via-yellow-500 to-transparent opacity-20 blur-sm"
          >
          </div>
          <div class="card-bg rounded-2xl p-8 relative z-10 h-full">
            <div class="flex items-center gap-4 mb-6">
              <div
                class="w-12 h-12 rounded-xl bg-gradient-to-br from-yellow-500 to-yellow-600 flex items-center justify-center"
              >
                <Zap class="w-6 h-6 text-white" />
              </div>
              <div>
                <h3 class="text-xl font-semibold">Tools & Workflow</h3>
                <p class="text-sm text-muted-foreground">Development Tools</p>
              </div>
            </div>

            <div class="space-y-3">
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">Git</span>
                <div class="w-2 h-2 rounded-full bg-yellow-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">VS Code</span>
                <div class="w-2 h-2 rounded-full bg-yellow-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">Xcode</span>
                <div class="w-2 h-2 rounded-full bg-yellow-500"></div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-muted-custom rounded-lg"
              >
                <span class="text-sm font-medium">Android Studio</span>
                <div class="w-2 h-2 rounded-full bg-yellow-500"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
