---
import "../styles/global.css"
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Alex Chen - Mobile Application Developer specializing in React Native, Flutter, and iOS/Android development. Creating innovative mobile experiences."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Mobile Application Developer specializing in React Native, Flutter, and iOS/Android development."
    />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://alexchen.dev" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-background text-foreground antialiased">
    <slot />

    <script>
      // Theme initialization
      function initTheme() {
        const theme = localStorage.getItem("theme") || "dark";
        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.classList.toggle("light", theme === "light");
      }

      // Initialize theme immediately
      initTheme();

      // Listen for theme changes
      document.addEventListener("DOMContentLoaded", () => {
        const themeToggle = document.getElementById("theme-toggle");
        if (themeToggle) {
          themeToggle.addEventListener("click", () => {
            const isDark = document.documentElement.classList.contains("dark");
            const newTheme = isDark ? "light" : "dark";

            document.documentElement.classList.remove("dark", "light");
            document.documentElement.classList.add(newTheme);
            localStorage.setItem("theme", newTheme);

            // Update toggle state
            themeToggle.setAttribute("data-theme", newTheme);
          });

          // Set initial toggle state
          const currentTheme = localStorage.getItem("theme") || "dark";
          themeToggle.setAttribute("data-theme", currentTheme);
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --orange-primary: #ef8801;
    --orange-secondary: #ff6b35;
    --radius: 0.5rem;
  }

  /* Dark theme (original) */
  :root,
  .dark {
    --background: #0a0a0c;
    --foreground: #ffffff;
    --card: #0a0a0c;
    --card-foreground: #ffffff;
    --popover: #0a0a0c;
    --popover-foreground: #ffffff;
    --primary: #ef8801;
    --primary-foreground: #ffffff;
    --secondary: #1a1a1f;
    --secondary-foreground: #ffffff;
    --muted: #1a1a1f;
    --muted-foreground: #a1a1aa;
    --accent: #1a1a1f;
    --accent-foreground: #ffffff;
    --destructive: #ef4444;
    --destructive-foreground: #ffffff;
    --border: #2a2a35;
    --input: #2a2a35;
    --ring: #ef8801;
  }

  /* Light theme */
  .light {
    --background: #ffffff;
    --foreground: #0a0a0c;
    --card: #ffffff;
    --card-foreground: #0a0a0c;
    --popover: #ffffff;
    --popover-foreground: #0a0a0c;
    --primary: #ef8801;
    --primary-foreground: #ffffff;
    --secondary: #f8f9fa;
    --secondary-foreground: #0a0a0c;
    --muted: #f8f9fa;
    --muted-foreground: #6b7280;
    --accent: #f8f9fa;
    --accent-foreground: #0a0a0c;
    --destructive: #ef4444;
    --destructive-foreground: #ffffff;
    --border: #e5e7eb;
    --input: #e5e7eb;
    --ring: #ef8801;
  }

  html {
    scroll-behavior: smooth;
  }

  /* Correction du décalage de scroll pour les ancres */
  section[id] {
    scroll-margin-top: 6rem;
  }

  @media (min-width: 768px) {
    section[id] {
      scroll-margin-top: 7rem;
    }
  }

  body {
    font-family: "Space Grotesk", system-ui, sans-serif;
    background-color: var(--background);
    color: var(--foreground);
    overflow-x: hidden;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  /* Enhanced gradient utilities for 2025 design trends */
  .bg-radial-gradient {
    background: radial-gradient(
      ellipse at center,
      var(--tw-gradient-from),
      var(--tw-gradient-to)
    );
  }

  /* Enhanced gradient backgrounds that adapt to theme */
  .hero-gradient {
    background: radial-gradient(
        ellipse 80% 50% at 50% 0%,
        rgba(239, 136, 1, 0.15),
        transparent
      ),
      radial-gradient(
        ellipse 60% 40% at 80% 100%,
        rgba(139, 69, 19, 0.1),
        transparent
      ),
      linear-gradient(
        135deg,
        rgba(239, 136, 1, 0.05) 0%,
        rgba(168, 85, 247, 0.03) 50%,
        rgba(59, 130, 246, 0.05) 100%
      );
    transition: all 0.3s ease;
  }

  .light .hero-gradient {
    background: radial-gradient(
        ellipse 80% 50% at 50% 0%,
        rgba(239, 136, 1, 0.08),
        transparent
      ),
      radial-gradient(
        ellipse 60% 40% at 80% 100%,
        rgba(139, 69, 19, 0.05),
        transparent
      ),
      linear-gradient(
        135deg,
        rgba(239, 136, 1, 0.03) 0%,
        rgba(168, 85, 247, 0.02) 50%,
        rgba(59, 130, 246, 0.03) 100%
      );
  }

  /* Enhanced section gradients */
  .section-gradient {
    background: linear-gradient(
      180deg,
      rgba(239, 136, 1, 0.02) 0%,
      transparent 50%,
      rgba(168, 85, 247, 0.02) 100%
    );
    transition: background 0.3s ease;
  }

  .light .section-gradient {
    background: linear-gradient(
      180deg,
      rgba(239, 136, 1, 0.01) 0%,
      transparent 50%,
      rgba(168, 85, 247, 0.01) 100%
    );
  }

  /* Enhanced gradient text with better fallbacks */
  .gradient-text {
    background: linear-gradient(135deg, #ef8801 0%, #ff6b35 50%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }

  /* Enhanced glass morphism with gradients */
  .glass {
    background: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.1),
        rgba(255, 255, 255, 0.05)
      ),
      rgba(26, 26, 31, 0.5);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .light .glass {
    background: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.9),
        rgba(255, 255, 255, 0.7)
      ),
      rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  /* Noise overlay - adapts to theme */
  .noise-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("data:image/svg+xml;base64,");
    pointer-events: none;
    z-index: 9997;
    opacity: 0.4;
    transition: opacity 0.3s ease;
  }

  .light .noise-overlay {
    opacity: 0.1;
  }

  .grain-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("data:image/svg+xml;base64,");
    pointer-events: none;
    z-index: 9996;
    opacity: 0.02;
    animation: grain 8s steps(10) infinite;
    transition: opacity 0.3s ease;
  }

  .light .grain-overlay {
    opacity: 0.01;
  }

  @keyframes grain {
    0%,
    100% {
      transform: translate(0, 0);
    }
    10% {
      transform: translate(-5%, -10%);
    }
    20% {
      transform: translate(-15%, 5%);
    }
    30% {
      transform: translate(7%, -25%);
    }
    40% {
      transform: translate(-5%, 25%);
    }
    50% {
      transform: translate(-15%, 10%);
    }
    60% {
      transform: translate(15%, 0%);
    }
    70% {
      transform: translate(0%, 15%);
    }
    80% {
      transform: translate(3%, 35%);
    }
    90% {
      transform: translate(-10%, 10%);
    }
  }

  /* Reveal animations */
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.8s ease,
      transform 0.8s ease;
  }

  .reveal.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-delay-1 {
    transition-delay: 0.1s;
  }

  .reveal-delay-2 {
    transition-delay: 0.2s;
  }

  .reveal-delay-3 {
    transition-delay: 0.3s;
  }

  .reveal-delay-4 {
    transition-delay: 0.4s;
  }

  .reveal-delay-5 {
    transition-delay: 0.5s;
  }

  /* Gradient text */
  .gradient-text {
    background: linear-gradient(
      to right,
      var(--orange-primary),
      var(--orange-secondary)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }

  /* Glassmorphism - adapts to theme */
  .glass {
    background: rgba(26, 26, 31, 0.5);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
  }

  .light .glass {
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  /* Neon glow - adapts to theme */
  .neon-glow {
    box-shadow:
      0 0 10px rgba(239, 136, 1, 0.3),
      0 0 20px rgba(239, 136, 1, 0.2),
      0 0 30px rgba(239, 136, 1, 0.1);
    transition: box-shadow 0.3s ease;
  }

  .light .neon-glow {
    box-shadow:
      0 0 10px rgba(239, 136, 1, 0.2),
      0 0 20px rgba(239, 136, 1, 0.1),
      0 0 30px rgba(239, 136, 1, 0.05);
  }

  /* Accessibility focus styles */
  :focus-visible {
    outline: 2px solid var(--orange-primary);
    outline-offset: 2px;
  }

  /* Theme-specific decorative elements */
  .decorative-bg {
    background: rgba(239, 136, 1, 0.05);
    transition: background 0.3s ease;
  }

  .light .decorative-bg {
    background: rgba(239, 136, 1, 0.03);
  }

  /* Section backgrounds that adapt to theme */
  .section-alt {
    background: #0d0d10;
    transition: background 0.3s ease;
  }

  .light .section-alt {
    background: #f9fafb;
  }

  /* Card backgrounds */
  .card-bg {
    background: #0d0d10;
    transition: background 0.3s ease;
  }

  .light .card-bg {
    background: #ffffff;
    border: 1px solid #e5e7eb;
  }

  /* Muted backgrounds */
  .bg-muted-custom {
    background: rgba(26, 26, 31, 0.3);
    transition: background 0.3s ease;
  }

  .light .bg-muted-custom {
    background: rgba(248, 249, 250, 0.8);
  }

  /* Border colors */
  .border-custom {
    border-color: rgba(255, 255, 255, 0.05);
    transition: border-color 0.3s ease;
  }

  .light .border-custom {
    border-color: rgba(0, 0, 0, 0.1);
  }

  /* Hover states */
  .hover-bg-custom:hover {
    background: rgba(255, 255, 255, 0.05);
    transition: background 0.3s ease;
  }

  .light .hover-bg-custom:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  /* Project cards specific styling */
  .project-card {
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
  }

  .light .project-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    box-shadow:
      0 1px 3px 0 rgba(0, 0, 0, 0.1),
      0 1px 2px 0 rgba(0, 0, 0, 0.06);
  }

  .light .project-card:hover {
    box-shadow:
      0 10px 15px -3px rgba(0, 0, 0, 0.1),
      0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }

  /* Experience card styling */
  .experience-card {
    background: rgba(26, 26, 31, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
  }

  .light .experience-card {
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #e5e7eb;
    box-shadow:
      0 1px 3px 0 rgba(0, 0, 0, 0.1),
      0 1px 2px 0 rgba(0, 0, 0, 0.06);
  }

  /* Experience title styling */
  .experience-title {
    color: #ffffff;
    transition: color 0.3s ease;
  }

  .light .experience-title {
    color: #0a0a0c;
  }
</style>
