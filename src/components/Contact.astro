<section id="contact" class="section-block min-h-[72dvh] flex items-center">
  <div class="section-wrap w-full">
    <header class="section-head reveal" style="--stagger:0;">
      <p class="eyebrow">Contact</p>
      <h2 class="display-section max-w-[8ch]">Parlons de votre prochain produit.</h2>
      <p class="copy max-w-[62ch]">
        Échange direct par email ou via mes profils sociaux. Je réponds généralement sous 24 heures.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1.02fr_0.98fr] lg:gap-10">
      <article class="reveal" style="--stagger:1;">
        <div class="rule"></div>
        <h3 class="mt-6 max-w-[14ch] text-3xl tracking-tight md:text-5xl">
          Conception claire,
          <br />
          code propre,
          <br />
          livraison maîtrisée.
        </h3>

        <p class="copy mt-5 max-w-[56ch]">
          Basé à Strasbourg, France. Disponible pour des missions à distance ou hybrides sur des produits web orientés usage réel.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a href="mailto:picard.boris@outlook.fr" class="btn-primary" target="_blank" rel="noopener noreferrer">Envoyer un email</a>
          <a href="#projects" class="btn-secondary">Voir les projets</a>
        </div>
      </article>

      <article class="reveal" style="--stagger:2;">
        <div class="rule"></div>

        <div class="mt-6 divide-y divide-[color:var(--surface-border)] text-sm md:text-base">
          <a
