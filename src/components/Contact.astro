---
import {
  Mail,
  MapPin,
  Github,
  Linkedin,
  ArrowRight,
  MessageCircle,
  Clock,
} from "lucide-react";
---

<section
  id="contact"
  class="min-h-screen py-32 relative overflow-hidden flex items-center"
>
  <div
    class="absolute inset-0 bg-gradient-to-br from-orange-500/8 via-transparent to-amber-500/6"
  >
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-tl from-yellow-500/4 via-transparent to-orange-500/5"
  >
  </div>
  <div
    class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-gradient-to-br from-orange-500/12 to-amber-500/8 blur-3xl"
  >
  </div>
  <div
    class="absolute bottom-1/4 right-1/4 w-64 h-64 rounded-full bg-gradient-to-br from-yellow-500/8 to-orange-500/6 blur-3xl"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 relative z-10 w-full">
    <!-- Header compact -->
    <div class="text-center mb-12 reveal">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">Me contacter</h2>
      <div
        class="w-20 h-1 bg-gradient-to-r from-orange-500 to-amber-600 rounded-full mx-auto mb-6"
      >
      </div>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        Vous avez un projet web ? N’hésitez pas à me laisser un message.
      </p>
    </div>

    <!-- Card principale - Taille optimisée -->
    <div
      class="glass rounded-3xl p-[1px] overflow-hidden reveal reveal-delay-1"
    >
      <div
        class="absolute -inset-[1px] bg-gradient-to-r from-orange-500/20 via-amber-500/15 to-yellow-500/20 blur-sm"
      >
      </div>
      <div class="card-bg rounded-3xl p-8 md:p-10 relative z-10">
        <!-- Header de la card -->
        <div class="text-center mb-8">
          <h3
            class="text-2xl font-semibold mb-4 flex items-center justify-center gap-3"
          >
            <MessageCircle className="w-6 h-6 text-orange-500" />
            Restons en contact
          </h3>
          <!-- <div class="text-center">
            <div
              class="inline-flex items-center gap-2 px-4 py-2 bg-green-500/10 border border-green-500/20 rounded-full"
            >
              <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse">
              </div>
              <span class="text-sm text-green-600 font-medium"
                >Disponible pour de nouveaux projets</span
              >
            </div>
          </div> -->
        </div>

        <!-- Grid compact et bien organisé -->
        <div class="grid md:grid-cols-2 gap-8">
          <!-- Colonne gauche - Contact principal -->
          <div class="space-y-6">
            <!-- Email -->
            <a
              href="mailto:picard.boris@outlook.fr"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Envoyer un email à Boris Picard"
              class="flex items-center gap-4 p-4 border border-custom rounded-xl hover-bg-custom group hover:shadow-lg hover:ring-1 hover:ring-orange-500/20 transition-all"
            >
              <div
                class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center text-white group-hover:scale-105 transition-transform"
              >
                <Mail className="w-5 h-5" aria-hidden="true" />
              </div>
              <div class="flex-1">
                <p class="font-medium">Email</p>
                <span class="block font-medium text-sm">
                  picard.boris@outlook.fr
                </span>
              </div>
              <ArrowRight
                className="w-4 h-4 text-muted-foreground opacity-80 transition-all duration-200 ease-out group-hover:translate-x-1 group-hover:opacity-100"
              />
            </a>

            <!-- GitHub -->
            <a
              href="https://github.com/Boris-Picard"
              target="_blank"
              rel="noopener noreferrer"
              title="Voir mon profil GitHub"
              aria-label="Profil GitHub de Boris Picard"
              class="flex items-center gap-4 p-4 border border-custom rounded-xl hover-bg-custom group hover:shadow-lg hover:ring-1 hover:ring-orange-500/20 transition-all"
            >
              <div
                class="w-12 h-12 rounded-xl bg-gradient-to-br from-gray-700 to-gray-500 flex items-center justify-center text-white group-hover:scale-105 transition-transform"
              >
                <Github className="w-5 h-5" aria-hidden="true" />
              </div>
              <div class="flex-1">
                <p class="font-medium">GitHub</p>
                <span class="block font-medium text-sm">Voir mes projets</span>
              </div>
              <ArrowRight
                className="w-4 h-4 text-muted-foreground opacity-80 transition-all duration-200 ease-out group-hover:translate-x-1 group-hover:opacity-100"
              />
            </a>

            <!-- LinkedIn -->
            <a
              href="https://www.linkedin.com/in/boris-picard-2906029b/"
              target="_blank"
              rel="noopener noreferrer"
              title="Voir mon profil LinkedIn"
              class="flex items-center gap-4 p-4 border border-custom rounded-xl hover-bg-custom group hover:shadow-lg hover:ring-1 hover:ring-orange-500/20 transition-all"
            >
              <div
                class="w-12 h-12 rounded-xl bg-gradient-to-br from-[#0A66C2] to-[#147BD1] flex items-center justify-center text-white group-hover:scale-105 transition-transform"
              >
                <Linkedin className="w-5 h-5" aria-hidden="true" />
              </div>
              <div class="flex-1">
                <p class="font-medium">LinkedIn</p>
                <span class="block font-medium text-sm">
                  Mon profil professionnel LinkedIn
                </span>
              </div>
              <ArrowRight
                className="w-4 h-4 text-muted-foreground opacity-80 transition-all duration-200 ease-out group-hover:translate-x-1 group-hover:opacity-100"
              />
            </a>
          </div>

          <!-- Colonne droite - Infos complémentaires -->
          <div class="space-y-6 w-full flex flex-col justify-center">
            <!-- Réponse rapide -->
            <div
              class="p-6 bg-gradient-to-br from-orange-500/10 to-amber-500/5 rounded-2xl border border-orange-500/20 w-full"
            >
              <div class="flex items-center gap-3 mb-4">
                <Clock className="w-5 h-5 text-orange-500" />
                <h4 class="font-semibold">Réponse rapide</h4>
              </div>
              <p class="text-muted-foreground text-sm leading-relaxed">
                Je réponds généralement sous 24 heures.
              </p>
            </div>

            <!-- Localisation -->
            <div
              class="flex items-center gap-4 p-4 border border-custom rounded-xl w-full"
            >
              <div
                class="w-12 h-12 rounded-xl bg-gradient-to-br from-yellow-500 to-yellow-600 flex items-center justify-center text-white"
              >
                <MapPin className="w-5 h-5" />
              </div>
              <div>
                <p class="font-medium">Localisation</p>
                <p class="text-muted-foreground text-sm">Strasbourg, France</p>
                <p class="text-xs text-orange-500 mt-1">
                  Disponible pour du travail à distance
                </p>
              </div>
            </div>

            <!-- Disponibilité -->
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
