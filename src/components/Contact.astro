                </svg>
              </span>
              <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">E-mail</p>
                <p class="mt-1">picard.boris@outlook.fr</p>
              </div>
            </div>
            <span aria-hidden="true">-&gt;</span>
          </a>

          <a
            href="https://github.com/Boris-Picard"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between gap-3 py-4 transition-colors duration-200 hover:text-[color:var(--accent-solid)]"
