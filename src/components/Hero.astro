---
import { buttonVariants } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { ChevronRight, Github, Linkedin, Mail } from "lucide-react";
import { cn } from "@/lib/utils";
---

<section
  id="hero"
  class="min-h-screen flex items-center justify-center relative overflow-hidden"
>
  <!-- Refined subtle yet impactful gradient background -->
  <div class="absolute inset-0">
    <!-- Primary subtle mesh gradient -->
    <div
      class="absolute inset-0 bg-gradient-to-br from-orange-500/6 via-transparent to-amber-500/4"
    >
    </div>
    <!-- Secondary depth layer -->
    <div
      class="absolute inset-0 bg-gradient-to-tr from-rose-500/3 via-transparent to-orange-500/5"
    >
    </div>
    <!-- Radial focus gradient -->
    <div
      class="absolute inset-0 bg-radial-gradient from-orange-500/8 via-transparent to-transparent opacity-60"
    >
    </div>
    <!-- Animated subtle orbs -->
    <div
      class="absolute top-1/4 left-1/3 w-96 h-96 rounded-full bg-gradient-to-br from-orange-500/8 via-amber-400/4 to-transparent blur-3xl animate-pulse opacity-70"
    >
    </div>
    <div
      class="absolute bottom-1/3 right-1/4 w-64 h-64 rounded-full bg-gradient-to-tl from-rose-500/6 via-orange-500/4 to-transparent blur-3xl animate-pulse delay-1000 opacity-50"
    >
    </div>
  </div>

  <!-- Decorative grid with hero-specific styling -->
  <div
    class="absolute inset-0 grid grid-cols-6 grid-rows-6 pointer-events-none opacity-10"
  >
    {
      Array(36)
        .fill(0)
        .map((_, i) => <div class="border-[0.5px] border-orange-500/[0.03]" />)
    }
  </div>

  <div class="max-w-7xl mx-auto px-4 relative z-10 w-full">
    <div class="min-h-[calc(100vh-8rem)] flex items-center justify-center">
      <div class="flex flex-col items-center text-center w-full">
        <Badge
          variant="outline"
          className="mb-6 border-orange-500/30 text-orange-500 bg-orange-500/5 reveal reveal-delay-1"
        >
          Développeur Full Stack
        </Badge>

        <h1
          class="text-4xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight reveal reveal-delay-2"
        >
          Je développe des <span class="gradient-text">solutions web</span><br
          />
          fiables et modernes
        </h1>

        <p
          class="text-lg md:text-xl text-foreground/80 mb-8 max-w-2xl reveal reveal-delay-3"
        >
          Je suis <span class="text-orange-500 font-medium">Boris Picard</span>,
          développeur full stack. J’aime créer des outils web utiles,
          performants et bien construits.
        </p>

        <div
          class="flex flex-col sm:flex-row gap-4 mb-12 reveal reveal-delay-4"
        >
          <a
            href="mailto:picard.boris@outlook.fr"
            target="_blank"
            aria-label="Email"
            rel="noopener noreferrer"
            class={cn(
              buttonVariants({ size: "lg" }),
              "border-orange-500/20 hover:bg-orange-500/10 rounded-full px-8 py-6 inline-flex items-center group"
            )}
          >
            <span>Me contacter</span>
            <Mail
              className="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
            />
          </a>

          <a
            href="#projects"
            aria-label="Mes projets"
            class={cn(
              buttonVariants({ variant: "outline", size: "lg" }),
              "border-orange-500/20 hover:bg-orange-500/10 hover:text-orange-500 rounded-full px-8 py-6"
            )}
          >
            Voir mes projets
          </a>
        </div>

        <!-- Social Links -->
        <div class="flex flex-col items-center gap-6 reveal reveal-delay-4">
          <div class="flex items-center gap-2 text-sm text-foreground/60">
            <div class="w-8 h-[1px] bg-orange-500/30"></div>
            <span>Sur le web</span>
            <div class="w-8 h-[1px] bg-orange-500/30"></div>
          </div>

          <div class="flex items-center gap-6">
            <a
              href="https://github.com/Boris-Picard"
              class="group flex items-center justify-center w-12 h-12 rounded-full bg-orange-500/5 hover:bg-orange-500/10 transition-all duration-300"
              aria-label="GitHub Profile"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Github
                className="w-5 h-5 text-foreground/60 group-hover:text-orange-500 transition-colors"
              />
            </a>
            <a
              href="https://www.linkedin.com/in/boris-picard-2906029b/"
              class="group flex items-center justify-center w-12 h-12 rounded-full bg-orange-500/5 hover:bg-orange-500/10 transition-all duration-300"
              aria-label="LinkedIn Profile"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Linkedin
                className="w-5 h-5 text-foreground/60 group-hover:text-orange-500 transition-colors"
              />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
