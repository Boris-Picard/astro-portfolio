---
import pdf from "../assets/cv_boris_picard.pdf";

const navItems = [
  { href: "#hero", label: "Accueil" },
  { href: "#about", label: "Présentation" },
  { href: "#skills", label: "Compétences" },
  { href: "#projects", label: "Projets" },
  { href: "#contact", label: "Contact" },
];
---

<header id="site-header" class="site-header fixed inset-x-0 top-0 z-30 px-3 pt-3 sm:px-4 md:px-6 md:pt-4">
  <div class="section-wrap">
    <div class="nav-shell rounded-[1.1rem] px-3 sm:px-4 md:px-5">
      <nav class="grid h-14 grid-cols-[auto_1fr_auto] items-center gap-3 sm:h-16 md:h-[72px] md:gap-5" aria-label="Navigation principale">
        <a href="#hero" class="on-ink inline-flex items-center gap-2 text-sm md:text-base">
          <span class="on-ink-soft inline-flex h-7 w-7 items-center justify-center rounded-full border border-[color:var(--ink-panel-border)] text-[11px] font-medium">BP</span>
          <span class="font-medium tracking-tight">Boris Picard</span>
        </a>

        <div class="hidden items-center justify-center gap-7 lg:flex">
          {
            navItems.map((item) => (
              <a class="nav-link" href={item.href} data-nav-link>
                {item.label}
              </a>
            ))
          }
        </div>

        <div class="ml-auto flex shrink-0 items-center justify-end gap-2 sm:gap-3">
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Basculer le thème" aria-pressed="false">
            <span class="theme-toggle-icon" aria-hidden="true">
              <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="4.5"></circle>
                <path d="M12 2.5v2.2M12 19.3v2.2M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"></path>
              </svg>
              <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M21 13.2A8.5 8.5 0 1 1 10.8 3a7 7 0 0 0 10.2 10.2z"></path>
              </svg>
            </span>
            <span id="theme-label" class="hidden sm:inline">Clair</span>
          </button>

          <a href={pdf} download class="nav-cv hidden lg:inline-flex">
            <span>CV</span>
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
              <path d="M12 4v10"></path>
              <path d="m8.7 10.8 3.3 3.3 3.3-3.3"></path>
              <path d="M4 18h16"></path>
            </svg>
          </a>

          <button
            id="mobile-menu-trigger"
            class="on-ink inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-[color:var(--ink-panel-border)] bg-[color:var(--ink-panel-glass)] lg:hidden"
            aria-label="Ouvrir le menu"
            aria-expanded="false"
          >
            <span class="sr-only">Menu</span>
            <span class="relative block h-4 w-4">
              <span class="menu-line absolute left-0 top-0 h-[1.5px] w-4 bg-current transition-all"></span>
              <span class="menu-line absolute left-0 top-[6px] h-[1.5px] w-4 bg-current transition-all"></span>
              <span class="menu-line absolute left-0 top-[12px] h-[1.5px] w-4 bg-current transition-all"></span>
            </span>
          </button>
        </div>
      </nav>
    </div>
  </div>
</header>

<div id="mobile-overlay" class="fixed inset-0 z-20 invisible overflow-y-auto bg-[rgba(6,8,12,0.64)] opacity-0 backdrop-blur-md transition-all duration-300 lg:hidden">
  <div class="ink-block min-h-full w-full px-5 pb-10 pt-24 sm:px-8">
    <nav class="flex w-full flex-col gap-3">
      {
        navItems.map((item, idx) => (
          <a class="mobile-link reveal on-ink-soft rounded-2xl border border-[color:var(--ink-panel-border)] bg-[color:var(--ink-panel-glass)] px-4 py-4 text-xl tracking-tight" href={item.href} style={`--stagger:${idx};`}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <a href={pdf} download class="btn-primary mt-6 flex w-full justify-center">Télécharger mon CV</a>
  </div>
</div>

<script>
  const header = document.getElementById("site-header");
  const trigger = document.getElementById("mobile-menu-trigger");
  const overlay = document.getElementById("mobile-overlay");
  const mobileLinks = document.querySelectorAll(".mobile-link");
  const navLinks = document.querySelectorAll("[data-nav-link]");
  const sections = document.querySelectorAll("section[id]");
  const themeToggle = document.getElementById("theme-toggle");
  const themeLabel = document.getElementById("theme-label");

  let isOpen = false;
  let lastScrollY = window.scrollY;
  let ticking = false;
  let direction = 0;
  let movement = 0;

  const syncThemeLabel = () => {
    const isDark = document.documentElement.classList.contains("dark");
    if (themeLabel) {
      themeLabel.textContent = isDark ? "Sombre" : "Clair";
    }
    if (themeToggle) {
      themeToggle.setAttribute("aria-pressed", String(isDark));
      themeToggle.setAttribute("data-theme-mode", isDark ? "dark" : "light");
      themeToggle.setAttribute("aria-label", isDark ? "Activer le mode clair" : "Activer le mode sombre");
    }
  };

  const applyTheme = (theme) => {
    document.documentElement.classList.remove("light", "dark");
    document.documentElement.classList.add(theme);
    document.documentElement.dataset.theme = theme;
    localStorage.setItem("theme", theme);
    syncThemeLabel();
  };

  syncThemeLabel();

  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.contains("dark");
    applyTheme(isDark ? "light" : "dark");
  });

  const setOpen = (next) => {
    isOpen = next;
    trigger?.setAttribute("aria-expanded", String(next));
    overlay?.classList.toggle("opacity-0", !next);
    overlay?.classList.toggle("invisible", !next);
    overlay?.classList.toggle("opacity-100", next);
    header?.classList.remove("is-hidden");
    lastScrollY = window.scrollY;
    direction = 0;
    movement = 0;

    const lines = trigger?.querySelectorAll(".menu-line");
    if (!lines || lines.length < 3) return;

    if (next) {
      lines[0].style.transform = "translateY(6px) rotate(45deg)";
      lines[1].style.opacity = "0";
      lines[2].style.transform = "translateY(-6px) rotate(-45deg)";
      document.body.style.overflow = "hidden";
    } else {
      lines[0].style.transform = "";
      lines[1].style.opacity = "";
      lines[2].style.transform = "";
      document.body.style.overflow = "";
    }
  };

  trigger?.addEventListener("click", () => setOpen(!isOpen));

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  overlay?.addEventListener("click", (event) => {
    if (event.target === overlay) {
      setOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen) {
      setOpen(false);
    }
  });

  const setActiveLink = () => {
    const offset = window.scrollY + 140;
    let active = "#hero";

    sections.forEach((section) => {
      if (offset >= section.offsetTop) {
        active = `#${section.id}`;
      }
    });

    navLinks.forEach((link) => {
      link.classList.toggle("is-active", link.getAttribute("href") === active);
    });
  };

  const showHeader = () => {
    if (!header?.classList.contains("is-hidden")) return;
    header.classList.remove("is-hidden");
  };

  const hideHeader = () => {
    if (header?.classList.contains("is-hidden")) return;
    header?.classList.add("is-hidden");
  };

  const handleNavVisibility = () => {
    const currentScrollY = window.scrollY;

    if (isOpen) {
      showHeader();
      lastScrollY = currentScrollY;
      direction = 0;
      movement = 0;
      return;
    }

    if (currentScrollY < 56) {
      showHeader();
      lastScrollY = currentScrollY;
      direction = 0;
      movement = 0;
      return;
    }

    const delta = currentScrollY - lastScrollY;
    if (Math.abs(delta) < 2) return;

    const nextDirection = delta > 0 ? 1 : -1;
    if (nextDirection !== direction) {
      direction = nextDirection;
      movement = 0;
    }

    movement += Math.abs(delta);

    if (direction === 1 && movement > 16 && currentScrollY > 84) {
      hideHeader();
      movement = 0;
    } else if (direction === -1 && movement > 12) {
      showHeader();
      movement = 0;
    }

    lastScrollY = currentScrollY;
  };

  const onScroll = () => {
    if (ticking) return;

    ticking = true;
    window.requestAnimationFrame(() => {
      setActiveLink();
      handleNavVisibility();
      ticking = false;
    });
  };

  window.addEventListener("scroll", onScroll, { passive: true });
  setActiveLink();
  handleNavVisibility();
</script>
