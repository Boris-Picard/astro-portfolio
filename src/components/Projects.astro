---
import { projects } from "@/data/projects";
import { Badge } from "@/components/ui/badge";
import { Button, buttonVariants } from "@/components/ui/button";
import { Github, ExternalLink, ArrowRight } from "lucide-react";
import ProjectSlider from "@/components/ui/ProjectSlider";
import { cn } from "@/lib/utils";
---

<section
  id="projects"
  class="py-32 relative overflow-hidden"
  aria-labelledby="projects-heading"
>
  <div
    class="absolute inset-0 bg-gradient-to-bl from-orange-500/6 via-transparent to-amber-500/4"
  >
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-tr from-yellow-500/3 via-transparent to-orange-500/5"
  >
  </div>
  <div
    class="absolute bottom-1/4 left-1/3 w-96 h-96 rounded-full bg-gradient-to-tr from-orange-500/10 via-amber-500/6 to-transparent blur-3xl"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <!-- Header -->
    <div class="text-center mb-20 reveal">
      <h2 id="projects-heading" class="text-4xl md:text-5xl font-bold mb-4">
        Projets réalisés
      </h2>
      <div
        class="w-20 h-1 bg-gradient-to-r from-orange-500 to-amber-600 rounded-full mx-auto mb-8"
      >
      </div>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        Découvrez une sélection de projets web que j’ai développés, alliant
        performance, accessibilité et bonnes pratiques.
      </p>
    </div>

    <!-- Projects List -->
    <div class="space-y-32">
      {
        projects.map((proj, idx) => {
          const isFirst = idx % 2 === 0;
          const validSites =
            proj.site?.filter(({ name, link }) => name.trim() && link.trim()) ??
            [];
          const validGithubLinks =
            proj.github?.filter(
              ({ name, link }) => name.trim() && link.trim()
            ) ?? [];
          return (
            <article
              class="mb-32 reveal"
              aria-labelledby={`project-${idx}-title`}
            >
              <div class="grid md:grid-cols-2 gap-16 items-center">
                {/* Text block */}
                <div
                  class={`space-y-6 ${isFirst ? "md:order-1" : "md:order-2"}`}
                >
                  <div class="space-y-4">
                    <Badge
                      variant="outline"
                      className="px-4 py-2 rounded-md text-sm"
                      style={{
                        borderColor: proj.theme.border,
                        color: proj.theme.primary,
                        backgroundColor: proj.theme.light,
                      }}
                    >
                      {proj.type} Project
                    </Badge>
                    <h3
                      id={`project-${idx}-title`}
                      class="text-2xl md:text-3xl font-bold leading-tight"
                    >
                      {proj.title}
                    </h3>
                  </div>
                  <p class="text-muted-foreground leading-relaxed text-lg">
                    {proj.description}
                  </p>
                  <div class="flex flex-wrap gap-3">
                    {proj.techs.map((tech) => (
                      <Badge
                        className="rounded-md text-sm"
                        style={{
                          backgroundColor: proj.techColors[tech].bgColor,
                          color: proj.techColors[tech].color,
                          borderColor: proj.techColors[tech].borderColor,
                        }}
                      >
                        {tech}
                      </Badge>
                    ))}
                  </div>
                  <div class="flex gap-4 pt-2">
                    {validGithubLinks &&
                      validGithubLinks.map(({ name, link }) => (
                        <a
                          href={link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class={cn(
                            buttonVariants({
                              variant: "outline",
                              size: "default",
                            }),
                            "group transition-colors rounded-full"
                          )}
                          style={{ borderColor: proj.theme.border }}
                        >
                          <Github className="w-4 h-4 mr-2" />
                          <span>{name}</span>
                        </a>
                      ))}
                    {validSites &&
                      validSites.map(({ name, link }) => (
                        <a
                          href={link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class={cn(
                            buttonVariants({
                              variant: "default",
                              size: "default",
                            }),
                            "group rounded-full text-white border-none hover:opacity-90 transition-opacity"
                          )}
                          style={{
                            background: proj.theme.gradient,
                          }}
                        >
                          <span>{name}</span>
                          <ExternalLink className="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" />
                        </a>
                      ))}
                  </div>
                </div>

                {/* Image block */}
                <div class={isFirst ? "md:order-2" : "md:order-1"}>
                  <ProjectSlider
                    client:visible
                    images={proj.gallery.length ? proj.gallery : [proj.image]}
                    theme={proj.theme}
                  />
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <!-- <div class="text-center mt-16 reveal">
      <Button
        title="Accéder à la liste complète des projets développés"
        variant="outline"
        size="lg"
        className="border-orange-500/20 hover:bg-orange-500/10 hover:text-orange-500 rounded-full px-8 py-6 group"
      >
        <span>Voir tous mes projets web</span>
        <ArrowRight
          className="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
        />
      </Button>
    </div> -->
  </div>
</section>
