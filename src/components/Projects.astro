---
import { projects } from "@/data/projects";
import ProjectSlider from "@/components/ui/ProjectSlider.astro";

const projectTypeLabel: Record<string, string> = {
  Study: "Étude",
  Personal: "Personnel",
  Client: "Client",
  Featured: "À la une",
};
---

<section id="projects" class="section-block">
  <div class="section-wrap">
    <header class="section-head reveal" style="--stagger:0;">
      <p class="eyebrow">Projets sélectionnés</p>
      <h2 class="display-section max-w-[7ch]">Études de cas</h2>
      <p class="copy max-w-[62ch]">
        Projets développés en contexte personnel et académique, avec une attention particulière à la cohérence technique et à la qualité d’exécution.
      </p>
    </header>

    {
      projects.length > 0 ? (
        <div class="space-y-16 md:space-y-20">
          {
            projects.map((project, index) => {
              const caseNumber = String(index + 1).padStart(2, "0");
              const reverse = index % 2 === 1;
              const validGithub = project.github?.filter(({ name, link }) => name.trim() && link.trim()) ?? [];
              const validSites = project.site?.filter(({ name, link }) => name.trim() && link.trim()) ?? [];

              return (
                <article class="reveal relative" style={`--stagger:${index + 1};`} aria-labelledby={`project-title-${index}`}>
                  <div class="rule"></div>

                  <span class="pointer-events-none absolute right-0 top-4 font-mono text-[2.4rem] leading-none tracking-tight text-[color:var(--ghost-ink)] sm:top-6 sm:text-[2.9rem] md:top-8 md:text-[3.8rem] lg:text-[5.3rem]">
                    {caseNumber}
                  </span>

                  <div class="mt-6 flex items-center gap-3">
                    <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">{projectTypeLabel[project.type] ?? project.type}</p>
                  </div>

                  <h3 id={`project-title-${index}`} class="mt-3 max-w-[14ch] text-4xl tracking-tight sm:text-5xl lg:text-[4rem]">
                    {project.title}
                  </h3>

                  <div class="mt-6 grid grid-cols-1 gap-7 lg:grid-cols-[0.96fr_1.04fr] lg:gap-8">
                    <div class={`${reverse ? "lg:order-2" : ""} flex h-full flex-col`}>
                      <p class="copy mt-0 max-w-[58ch]">{project.description}</p>

                      <div class="mt-auto pt-6">
                        <div class="flex flex-wrap gap-2">
                          {
                            project.techs.map((tech) => (
                              <span class="tag">{tech}</span>
                            ))
                          }
                        </div>

                        <div class="mt-6 flex flex-wrap gap-2.5">
                          {
                            validGithub.map(({ name, link }) => (
                              <a href={link} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                  <path d="M9 19c-4 1.5-4-2-6-2m12 4v-3.9a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 19.1 4.8 5.07 5.07 0 0 0 19 1s-1.18-.35-3.9 1.48a13.38 13.38 0 0 0-7 0C5.38.65 4.2 1 4.2 1A5.07 5.07 0 0 0 4.1 4.8a5.44 5.44 0 0 0-1.46 3.7c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 8 17.1V21" />
                                </svg>
                                {name}
                              </a>
                            ))
                          }

                          {
                            validSites.map(({ name, link }) => (
                              <a href={link} target="_blank" rel="noopener noreferrer" class="btn-primary">
                                {name}
                                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                  <path d="M7 17 17 7" />
                                  <path d="M7 7h10v10" />
                                </svg>
                              </a>
                            ))
                          }
                        </div>
                      </div>
                    </div>

                    <div class={reverse ? "lg:order-1" : ""}>
                      <div class="surface-strong rounded-[1.35rem] p-3">
                        <ProjectSlider
                          images={project.gallery.length ? project.gallery : [project.image]}
                          priority={index === 0}
                        />
                      </div>
                    </div>
                  </div>
                </article>
              );
            })
          }
        </div>
      ) : (
        <article class="reveal" style="--stagger:1;">
          <div class="rule"></div>
          <p class="mt-5 text-sm text-muted">Aucun projet n’est disponible actuellement.</p>
        </article>
      )
    }
  </div>
</section>
