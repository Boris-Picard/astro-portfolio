---
import { skillColumns } from "@/data/skills";
import { normalizeTone } from "@/lib/color";

const descriptions: Record<string, string> = {
  "Front-end & Interface": "Interface, expérience utilisateur et intégration front.",
  "Back-end & API": "API, logique métier, sécurité et architecture serveur.",
  "Données & DevOps": "Données, automatisation, déploiement et qualité continue.",
};

---

<section id="skills" class="section-block">
  <div class="section-wrap">
    <header class="section-head reveal" style="--stagger:0;">
      <p class="eyebrow">Compétences</p>
      <h2 class="display-section max-w-[9ch]">Compétences techniques</h2>
      <p class="copy max-w-[62ch]">
        Front-end, back-end, données et DevOps. Outils utilisés quotidiennement sur des projets réels.
      </p>
    </header>

    {
      skillColumns.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-7">
          {
            skillColumns.map((column, idx) => {
              const isWide = idx === 0 || idx === 2;
              return (
                <article
                  class={`reveal rounded-[1.55rem] border border-[color:var(--surface-border)] bg-[color:var(--surface)] p-5 md:p-6 ${
                    isWide ? "md:col-span-7" : "md:col-span-5"
                  }`}
                  style={`--stagger:${idx + 1};`}
                >
                  <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">Pôle {String(idx + 1).padStart(2, "0")}</p>
                  <h3 class="mt-2 text-2xl tracking-tight md:text-4xl">{column.title}</h3>
                  <p class="mt-3 max-w-[52ch] text-sm leading-relaxed text-muted">
                    {descriptions[column.title] ?? "Compétences utilisées en contexte produit."}
                  </p>

                  <ul class="mt-5 grid grid-cols-1 gap-2 sm:grid-cols-2">
                    {
                      column.skills.map((skill) => {
                        const tone = normalizeTone(skill.color);
                        return (
                          <li class="inline-flex items-center gap-2 rounded-full border border-[color:var(--surface-border)] px-3 py-1.5 text-sm">
                            <span class="h-2 w-2 rounded-full" style={`background-color:${tone};`} aria-hidden="true"></span>
                            <span>{skill.name}</span>
                          </li>
                        );
                      })
                    }
                  </ul>
                </article>
              );
            })
          }
        </div>
      ) : (
        <article class="reveal" style="--stagger:1;">
          <div class="rule"></div>
          <p class="mt-5 text-sm text-muted">Aucune compétence renseignée pour le moment.</p>
        </article>
      )
    }
  </div>
</section>
